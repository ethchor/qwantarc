{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "developer.qwantarc.com" }],
      "destination": "/design/qig",
      "permanent": false
    },
    {
      "source": "/design",
      "has": [{ "type": "host", "value": "developer.qwantarc.com" }],
      "destination": "/design/qig",
      "permanent": false
    },
    {
      "source": "/design",
      "has": [{ "type": "host", "value": "(?:www\\.)?qwantarc\\.com" }],
      "destination": "https://developer.qwantarc.com/design/qig",
      "permanent": false
    },
    {
      "source": "/design/:path*",
      "has": [{ "type": "host", "value": "(?:www\\.)?qwantarc\\.com" }],
      "destination": "https://developer.qwantarc.com/design/:path*",
      "permanent": true
    }
  ]
}
