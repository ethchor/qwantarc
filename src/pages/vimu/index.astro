---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/ethchor/Diagram.astro';
import '../../styles/ethchor/base.css';
import '../../styles/ethchor/topo.css';
import '../../styles/ethchor/bauhaus.css';
import { KINDS } from '../../lib/ethchor/glyphs';
import { PICTOGRAMS } from '../../lib/ethchor/pictograms';
import { ALSO, CAPABILITIES, CASES, FOCUS, METHOD, PERSON, SIDE_QUEST, TOPICS } from '../../lib/ethchor/profile';

const TITLE = 'Vimu Kale · Hard problems, untangled';
const DESCRIPTION =
  'Vimu Kale is a software engineer for AI systems, software architecture and optimisation: the hard problems, untangled.';
const pad = (n: number) => String(n).padStart(2, '0');
const arrow =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>';
const down =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>';

/** The method's waypoints on the survey map, in percent of the map: one per step. */
const WAYS = [
  { x: 24, y: 42, mark: 'summit', height: '1,284 m' },
  { x: 55, y: 64, mark: 'cairns', height: '906 m' },
  { x: 82, y: 30, mark: 'flag', height: '1,102 m' },
];

/*
 * Migra (Pangram Pangram) is a display face this page can use for its map's annotations. It is a
 * commercial font, so it isn't bundled: put licensed .woff2 (or .woff, .otf, .ttf) files in
 * public/fonts/migra/ and the next build uses them, weights and italics read from the file names.
 * Until then it is Boska, a free face in the same spirit.
 */
const migraDir = join(process.cwd(), 'public', 'fonts', 'migra');
const WEIGHTS: [string, number][] = [
  ['extralight', 200],
  ['ultralight', 200],
  ['semibold', 600],
  ['extrabold', 800],
  ['ultrabold', 800],
  ['thin', 100],
  ['light', 300],
  ['regular', 400],
  ['book', 400],
  ['medium', 500],
  ['bold', 700],
  ['black', 900],
];
const FORMATS: Record<string, string> = { woff2: 'woff2', woff: 'woff', otf: 'opentype', ttf: 'truetype' };
const order = Object.keys(FORMATS);
const extOf = (f: string) => f.split('.').pop()!.toLowerCase();
const faces = new Map<string, string[]>();
if (existsSync(migraDir)) {
  const files = readdirSync(migraDir)
    .filter((f) => order.includes(extOf(f)))
    .sort((a, b) => order.indexOf(extOf(a)) - order.indexOf(extOf(b)));
  for (const f of files) {
    const name = f.toLowerCase().replace(/[^a-z]/g, '');
    const weight = WEIGHTS.find(([k]) => name.includes(k))?.[1] ?? 400;
    const key = `${weight} ${name.includes('italic') ? 'italic' : 'normal'}`;
    faces.set(key, [...(faces.get(key) ?? []), `url('/fonts/migra/${encodeURIComponent(f)}') format('${FORMATS[extOf(f)]}')`]);
  }
}
const migraCss = faces.size
  ? [...faces]
      .map(([key, src]) => {
        const [weight, style] = key.split(' ');
        return `@font-face{font-family:'Migra';src:${src.join(',')};font-weight:${weight};font-style:${style};font-display:swap}`;
      })
      .join('') + `:root{--serif:'Migra','Boska',Georgia,serif}`
  : '';
---

<Base title={TITLE} description={DESCRIPTION} origin={PERSON.origin} themeColor="#f1ece1" fonts="vimu" icon="/vimu-icon.svg" siteName={PERSON.name}>
  {migraCss && <style slot="head" is:inline set:html={migraCss} />}

  <!-- The red line: one path, one weight, and its point. Placed by the page script (thread.ts, route.ts). -->
  <svg class="thread" data-thread aria-hidden="true">
    <path class="thread-line" data-line></path>
    <g class="thread-tip" data-tip><circle class="thread-point" r="6.5"></circle></g>
  </svg>

  <header class="bar" data-bar>
    <a class="mark" href="#top" aria-label="Vimu Kale, top of the page">
      <svg class="mark-knot" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M3 15c3 0 4-2 5.5-4.5S12 5 15 5s4.5 2.6 3 5.2-5.4 3.2-6.6.6S13 6 16 7.5 19.5 14 21 19"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>
      Vimu Kale
    </a>
    <nav class="nav" aria-label="Sections">
      <a href="#method">Method</a>
      <a href="#work">Work</a>
      <a href="#range">Range</a>
    </nav>
    <a class="bar-cta" href="#contact" data-magnet>Let’s talk</a>
  </header>

  <main id="top">
    <!-- The hero: a Bauhaus composition on contour lines; both untangle as the page scrolls -->
    <section class="hero" data-hero aria-labelledby="hero-title">
      <canvas class="terrain" data-terrain aria-hidden="true"></canvas>
      <div class="hero-shapes" data-shapes aria-hidden="true">
        <span class="shape" data-shape="circle"><svg viewBox="0 0 100 100"><circle class="b-blue" cx="50" cy="50" r="50"></circle></svg></span>
        <span class="shape" data-shape="triangle"><svg viewBox="0 0 305 265"><path class="b-yellow" d="M152.5 0 305 265H0Z"></path></svg></span>
        <span class="shape" data-shape="square"><svg viewBox="0 0 100 100"><rect class="b-red" width="100" height="100"></rect></svg></span>
        <span class="shape" data-shape="half"><svg viewBox="0 0 200 100"><path class="b-black" d="M0 100a100 100 0 0 1 200 0Z"></path></svg></span>
        <span class="shape" data-shape="bar"><i></i></span>
        <span class="shape" data-shape="dot" data-origin><i></i></span>
      </div>
      <div class="hero-copy" data-hero-copy>
        <p class="kicker" data-fade>{FOCUS.join(' · ')}</p>
        <h1 id="hero-title" class="hero-title"><span>Hard problems,</span> <em>untangled.</em></h1>
        <p class="hero-sub" data-fade>
          I’m Vimu, a software engineer who designs AI systems and the architecture around them, then makes them fast. I do my best work when the
          answer isn’t obvious yet.
        </p>
        <div class="actions" data-fade>
          <a class="btn is-primary" href="#intro" data-magnet><span>Follow the thread</span><Fragment set:html={down} /></a>
          <a class="btn" href="#contact" data-magnet><span>Say hello</span></a>
        </div>
      </div>
      <p class="hero-hint" data-hint aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.4"></circle><circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.4"></circle><circle cx="12" cy="12" r="2" fill="currentColor"></circle></svg>
        Move to raise the ground
      </p>
      <p class="scroll-hint" data-scroll-hint aria-hidden="true">Scroll to untangle</p>
    </section>

    <section class="intro" id="intro" data-intro aria-label="What I do">
      <p class="intro-text" data-words>
        I work across the whole problem: the model, the architecture, the data and the interface. Give me something tangled, and I’ll <em>find the thread,</em> <mark data-mark>design the simplest system that holds,</mark> and make it fast.
      </p>
    </section>

    <!-- The method: a survey map, the red line the route between its waypoints -->
    <section class="method" id="method" data-method aria-labelledby="method-title">
      <div class="method-frame" data-method-frame>
        <header class="sec-head">
          <p class="kicker"><span class="kicker-n">01</span> Method</p>
          <h2 id="method-title" class="sec-title" data-split>How I untangle <em>things.</em></h2>
        </header>
        <figure class="map" data-map aria-hidden="true">
          <canvas class="map-canvas" data-map-canvas></canvas>
          {
            WAYS.map((w, i) => (
              <span class={`way way-${w.mark}`} data-way={i} style={`--x: ${w.x}%; --y: ${w.y}%`}>
                <span class="way-mark">
                  {w.mark === 'cairns' && (
                    <>
                      <i class="cairn" />
                      <i class="cairn" />
                      <i class="cairn" />
                    </>
                  )}
                </span>
                <span class="way-label">
                  <b>{pad(i + 1)}</b>
                  {METHOD[i].figure} · {w.height}
                </span>
              </span>
            ))
          }
          <span class="map-north">
            <svg viewBox="0 0 26 40"><path d="M13 1 20 25 13 20 6 25Z" fill="currentColor"></path><text x="13" y="38" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor">N</text></svg>
          </span>
          <span class="map-scale"><i></i><i></i><i></i><i></i><span>0</span><span>1 km</span></span>
          <span class="map-title">Survey of a hard problem</span>
          <span class="map-coord c-top">51°28′ N</span>
          <span class="map-coord c-side">0°07′ W</span>
        </figure>
        <ol class="steps">
          {
            METHOD.map((m, i) => (
              <li class="step" data-step={i}>
                <span class="step-sym" aria-hidden="true" />
                <div>
                  <span class="step-n">{pad(i + 1)}</span>
                  <h3>{m.title}</h3>
                  <p>{m.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- The work: Bauhaus posters, the diagrams built from the same shapes -->
    <section class="work" id="work" data-work aria-labelledby="work-title">
      <header class="sec-head work-head" data-work-head>
        <div>
          <p class="kicker"><span class="kicker-n">02</span> Selected work</p>
          <h2 id="work-title" class="sec-title" data-split>Seven problems, <em>solved.</em></h2>
          <p class="sec-lede">Across AI, data, platforms and fintech. Client names stay private; the problem, the architecture and the reasoning behind it don’t.</p>
        </div>
        <div
          class="legend"
          data-legend
          role="img"
          aria-label="How to read the diagrams: a triangle is an app, a circle a service, a square data, and a half-disc a system outside the build.">
          <span class="shape" data-shape="bar"></span>
          <span class="shape" data-shape="circle"><svg viewBox="0 0 100 100"><circle class="b-blue" cx="50" cy="50" r="50"></circle></svg></span>
          <span class="shape" data-shape="triangle"><svg viewBox="0 0 305 265"><path class="b-yellow" d="M152.5 0 305 265H0Z"></path></svg></span>
          <span class="shape" data-shape="square"><svg viewBox="0 0 100 100"><rect class="b-red" width="100" height="100"></rect></svg></span>
          <span class="shape" data-shape="half"><svg viewBox="0 0 200 100"><path class="b-black" d="M0 100a100 100 0 0 1 200 0Z"></path></svg></span>
          <span class="shape" data-shape="dot"></span>
          {KINDS.map((k) => <span class="legend-label" data-label={k.kind}>{k.label}</span>)}
        </div>
      </header>
      <div class="work-frame" data-work-frame>
        <div class="track" data-track>
          {
            CASES.map((c, i) => (
              <article class="panel" data-panel={i} aria-labelledby={`case-${c.slug}`}>
                <span class="panel-shape" aria-hidden="true" />
                <div class="panel-main">
                  <p class="panel-meta">
                    <span class="panel-n">{pad(i + 1)}</span>
                    <span>{c.tags.join(' · ')}</span>
                  </p>
                  <h3 id={`case-${c.slug}`} class="panel-title">
                    {c.title}
                  </h3>
                  <p class="panel-role">
                    {c.domain} · {c.role}
                  </p>
                  <h4 class="label">The problem</h4>
                  <p class="panel-problem">{c.problem}</p>
                  <h4 class="label">What I built</h4>
                  <p class="panel-did">{c.did}</p>
                </div>
                <div class="panel-side">
                  <figure class="fig-frame">
                    <Diagram id={c.slug} diagram={c.diagram} label={`System diagram: ${c.title}`} />
                  </figure>
                  <h4 class="label">Decisions</h4>
                  <ol class="decisions">
                    {c.decisions.map((d) => (
                      <li tabindex="0" data-nodes={d.nodes.join(' ')}>
                        <strong>{d.title}.</strong> {d.text}
                      </li>
                    ))}
                  </ol>
                  <ul class="stack" aria-label="Built with">
                    {c.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
        <p class="rail-count" aria-hidden="true"><span data-count>01</span> / {pad(CASES.length)}</p>
      </div>
    </section>

    <!-- The range: four capabilities, each a pictogram built from Bauhaus shapes -->
    <section class="range" id="range" data-range aria-labelledby="range-title">
      <header class="sec-head" data-range-head>
        <p class="kicker"><span class="kicker-n">03</span> Range</p>
        <h2 id="range-title" class="sec-title" data-split>All-rounder, <em>by design.</em></h2>
      </header>
      <ol class="caps" data-caps>
        {
          CAPABILITIES.map((c) => (
            <li class="cap" data-cap>
              <svg class="pict" viewBox="0 0 120 120" aria-hidden="true">
                <Fragment set:html={PICTOGRAMS[c.key]} />
              </svg>
              <h3 class="cap-title">{c.area}</h3>
              <p class="cap-note">{c.note}</p>
              <ul class="cap-items">
                {c.items.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <p class="also" data-also>{ALSO}</p>
    </section>

    <!-- The side quest: a plant of shapes that grows, follows the sun and leans to the cursor -->
    <section class="quest" id="side-quest" data-quest aria-labelledby="quest-title">
      <div class="quest-copy">
        <p class="kicker"><span class="kicker-n">04</span> Side quest</p>
        <h2 id="quest-title" class="sec-title" data-split>{SIDE_QUEST.name}</h2>
        <p class="sec-lede">{SIDE_QUEST.text}</p>
        <a class="btn" href={SIDE_QUEST.href} target="_blank" rel="noopener" data-magnet><span>Visit the nursery</span><Fragment set:html={arrow} /></a>
      </div>
      <figure class="garden" data-garden aria-hidden="true">
        <svg viewBox="0 0 400 400">
          <circle class="b-yellow" data-sun cx="34" cy="92" r="32"></circle>
          <g data-plant>
            <rect class="grow stem b-black" x="196" y="128" width="8" height="160" style="--i: 0"></rect>
            <path class="grow leaf-r b-blue" d="M204 236a44 44 0 0 1 88 0Z" style="--i: 1"></path>
            <path class="grow leaf-l b-blue" d="M196 196a38 38 0 0 0-76 0Z" style="--i: 2"></path>
            <g class="grow bud" style="--i: 3"><circle class="b-yellow" cx="200" cy="118" r="24"></circle><circle class="b-red" cx="200" cy="118" r="9"></circle></g>
          </g>
          <path class="b-red" d="M150 300H250L236 356H164Z"></path>
          <rect class="b-black" x="140" y="288" width="120" height="14"></rect>
          <rect class="b-black" x="24" y="356" width="352" height="10"></rect>
        </svg>
      </figure>
    </section>

    <!-- The contact: the form is a poster, and the red line comes to rest round the send button -->
    <section class="contact" id="contact" data-contact aria-labelledby="contact-title">
      <div class="contact-grid">
        <div class="contact-intro">
          <p class="kicker"><span class="kicker-n">05</span> Contact</p>
          <h2 id="contact-title" class="sec-title" data-split>Got a tangle? <em>Let’s pull the thread.</em></h2>
          <p class="sec-lede">A project, a role, an architecture review or just a hello. Every message reaches me directly.</p>
          <ul class="links">
            {
              PERSON.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                    <Fragment set:html={arrow} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="contact-card">
          <span class="card-shape" aria-hidden="true"></span>
          <form class="form" data-form novalidate>
            <fieldset>
              <legend class="label">What is it about?</legend>
              <div class="chips">
                {
                  TOPICS.map((t, i) => (
                    <label class="chip">
                      <input type="radio" name="topic" value={t} checked={i === 0} />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <div class="row">
              <div class="field">
                <label class="label" for="name-field">Name</label>
                <input id="name-field" name="name" type="text" autocomplete="name" required placeholder="Your name" />
                <p class="error" data-error-for="name">Enter your name.</p>
              </div>
              <div class="field">
                <label class="label" for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
                <p class="error" data-error-for="email">Enter an email address I can reply to.</p>
              </div>
            </div>
            <div class="field">
              <label class="label" for="message">Message</label>
              <textarea id="message" name="message" rows="5" required placeholder="A few lines about the problem."></textarea>
              <p class="error" data-error-for="message">Write a short message.</p>
            </div>
            <div class="trap" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="submit-row">
              <p class="hint" data-form-hint role="status" aria-live="polite">It goes straight to my inbox.</p>
              <button class="send" type="submit" data-send data-end>
                <span data-send-label>Send</span>
                <Fragment set:html={arrow} />
              </button>
            </div>
          </form>

          <section class="sent" data-sent hidden tabindex="-1" aria-labelledby="sent-title">
            <p class="kicker">Sent</p>
            <h3 id="sent-title" class="sent-title">Thank you<span data-sent-name></span>.</h3>
            <p class="sec-lede">Your message is on its way. I’ll reply to <span data-sent-email></span> soon.</p>
            <div class="submit-row">
              <span></span>
              <button class="btn" type="button" data-again data-end>Send another</button>
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {PERSON.name}</span>
    <span>Hand-made with Astro and GSAP.</span>
    <span class="foot-links">
      {
        PERSON.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener">
            {l.label}
            <Fragment set:html={arrow} />
          </a>
        ))
      }
    </span>
  </footer>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { createMap } from '../../components/ethchor/map';
  import { buildRuns } from '../../components/ethchor/route';
  import { createTerrain } from '../../components/ethchor/terrain';
  import { createThread, type Thread } from '../../components/ethchor/thread';

  gsap.registerPlugin(ScrollTrigger, SplitText);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;
  const root = document.documentElement;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  // Styles that animate things in only apply when motion is welcome.
  if (!reduce) root.classList.add('motion');
  const ink = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();

  const hero = $('[data-hero]');
  const intro = $('[data-intro]');
  const method = $('[data-method]');
  const methodFrame = $('[data-method-frame]');
  const work = $('[data-work]');
  const workFrame = $('[data-work-frame]');
  const track = $('[data-track]');
  const range = $('[data-range]');
  const quest = $('[data-quest]');
  const contact = $('[data-contact]');
  const hint = $('[data-hint]');
  /** Where the red line runs, in from the right edge (--line-x in base.css). */
  const lane = () => Math.max(14, Math.min(64, Math.max(18, innerWidth * 0.044)) / 2);

  /* ---------- The hero: contour lines and a composition, both untangling as you scroll ---------- */
  const terrain = createTerrain({
    canvas: $<HTMLCanvasElement>('[data-terrain]'),
    surface: hero,
    colors: { line: ink('--contour'), index: ink('--contour-index') },
    reduce,
  });
  if (reduce) terrain.render();
  hero.addEventListener('pointermove', () => hint.classList.add('is-done'), { once: true });

  const shapesBox = $('[data-shapes]');
  const shapes = $$('[data-shape]', shapesBox);
  /**
   * The composition in order: each shape's centre and width as shares of the box, set down one at a
   * time (the rule first, the red dot last). Two shapes on a row, two standing on the rule, and the
   * dot at the end of the rule, where the line leaves it.
   */
  const ORDER: Record<string, { x: number; y: number; size: number; at: number }> = {
    bar: { x: 0.5, y: 0.86, size: 0.84, at: 0 },
    square: { x: 0.27, y: 0.305, size: 0.3, at: 1 },
    circle: { x: 0.7, y: 0.295, size: 0.32, at: 2 },
    triangle: { x: 0.27, y: 0.7, size: 0.34, at: 3 },
    half: { x: 0.7, y: 0.757, size: 0.36, at: 4 },
    dot: { x: 0.955, y: 0.86, size: 0.06, at: 5 },
  };
  let order: gsap.core.Timeline | null = null;
  function setOrder() {
    const at = order ? order.progress() : reduce ? 1 : 0;
    order?.progress(0).kill();
    const S = shapesBox.clientWidth;
    const tl = gsap.timeline({ paused: true, defaults: { duration: 1, ease: 'power3.inOut' } });
    shapes.forEach((el) => {
      const t = ORDER[el.dataset.shape!];
      const w = el.offsetWidth;
      const h = el.offsetHeight;
      const move = { x: t.x * S - (el.offsetLeft + w / 2), y: t.y * S - (el.offsetTop + h / 2), rotation: 0 };
      // The rule only changes length, so its weight stays the same.
      const size = el.dataset.shape === 'bar' ? { scaleX: (t.size * S) / w, scaleY: 1 } : { scale: (t.size * S) / w };
      tl.to(el, { ...move, ...size }, t.at * 0.14);
    });
    tl.progress(at);
    order = tl;
  }
  // On a phone the composition takes the room the copy leaves above it, so the copy is measured.
  const heroCopy = $('[data-hero-copy]');
  const measureCopy = () => hero.style.setProperty('--copy', `${heroCopy.offsetHeight}px`);
  measureCopy();
  setOrder();
  /** How untangled the hero is, from its pinned scroll, and the same eased so wheel steps don't jump. */
  let calmTo = 0;
  let calm = 0;

  /* ---------- The method: the survey map ---------- */
  const mapEl = $('[data-map]');
  const ways = $$('[data-way]');
  const map = createMap({
    canvas: $<HTMLCanvasElement>('[data-map-canvas]'),
    // A hill under each waypoint: the summit highest, the cairns on a broad shoulder, the flag between.
    peaks: () => {
      const w = mapEl.clientWidth;
      return ways.map((el, i) => ({ x: el.offsetLeft - 7, y: el.offsetTop - 7, height: [1, 0.5, 0.78][i], spread: w * [0.13, 0.12, 0.1][i] }));
    },
    color: ink('--contour'),
    index: ink('--contour-index'),
  });

  /* ---------- The work: the key falls into a row ---------- */
  const legend = $('[data-legend]');
  const keyShapes = $$('[data-shape]', legend);
  const keyLabels = $$('[data-label]', legend);
  /**
   * The key in its row: each shape's centre and size in shares of the box's width, sitting on the
   * rule at 72% of its height, placed in turn (the rule first, the full stop last).
   */
  const ROW: Record<string, { x: number; size: number; at: number; kind?: string }> = {
    bar: { x: 0.46, size: 0.78, at: 0 },
    square: { x: 0.13, size: 0.12, at: 1, kind: 'data' },
    circle: { x: 0.295, size: 0.12, at: 2, kind: 'service' },
    triangle: { x: 0.4675, size: 0.135, at: 3, kind: 'app' },
    half: { x: 0.6475, size: 0.135, at: 4, kind: 'outside' },
    dot: { x: 0.78, size: 0.04, at: 5 },
  };
  let key: gsap.core.Timeline | null = null;
  function setKey() {
    const at = key ? key.progress() : reduce ? 1 : 0;
    key?.progress(0).kill();
    const W = legend.clientWidth;
    const base = legend.clientHeight * 0.72;
    const tl = gsap.timeline({ paused: true, defaults: { duration: 1, ease: 'power3.inOut' } });
    keyShapes.forEach((el) => {
      const t = ROW[el.dataset.shape!];
      const w = el.offsetWidth;
      const h = el.offsetHeight;
      const cx = el.offsetLeft + w / 2;
      const cy = el.offsetTop + h / 2;
      if (el.dataset.shape === 'bar') {
        tl.to(el, { x: t.x * W - cx, y: base + h / 2 - cy, rotation: 0, scaleX: (t.size * W) / w, scaleY: 1 }, 0);
      } else {
        const s = (t.size * W) / w;
        tl.to(el, { x: t.x * W - cx, y: base - (h * s) / 2 - cy, rotation: 0, scale: s }, t.at * 0.16);
      }
    });
    // Then the names, under the rule.
    const rule = keyShapes.find((el) => el.dataset.shape === 'bar')!.offsetHeight;
    keyLabels.forEach((label) => {
      const t = Object.values(ROW).find((r) => r.kind === label.dataset.label)!;
      label.style.left = `${t.x * W}px`;
      label.style.top = `${base + rule + 12}px`;
    });
    tl.to(keyLabels, { opacity: 1, duration: 0.3, stagger: 0.08 }, '>-0.2');
    tl.progress(at);
    key = tl;
  }
  setKey();

  /* ---------- The side quest: the plant follows the sun, or leans to the cursor ---------- */
  const garden = $('[data-garden]');
  const sun = $<SVGCircleElement>('[data-sun]');
  const plant = $<SVGGElement>('[data-plant]');
  const PIVOT = { x: 200, y: 288 };
  gsap.set(plant, { svgOrigin: `${PIVOT.x} ${PIVOT.y}` });
  const lean = gsap.quickTo(plant, 'rotation', { duration: 0.9, ease: 'power3.out' });
  let sunAt = { x: 34, y: 92 };
  let cursor: { x: number; y: number } | null = null;
  const aim = () => {
    const t = cursor ?? sunAt;
    const deg = (Math.atan2(t.x - PIVOT.x, PIVOT.y - t.y) * 180) / Math.PI;
    lean(Math.max(-22, Math.min(22, deg * 0.35)));
  };
  /** The sun's way across the sky, 0 to 1. */
  const placeSun = (t: number) => {
    const a = ((235 + 70 * t) * Math.PI) / 180;
    sunAt = { x: 200 + 290 * Math.cos(a), y: 330 + 290 * Math.sin(a) };
    sun.setAttribute('cx', sunAt.x.toFixed(1));
    sun.setAttribute('cy', sunAt.y.toFixed(1));
    if (!cursor) aim();
  };
  // A still page shows it in the afternoon, clear of the flower.
  placeSun(reduce ? 0.85 : 0);
  if (!reduce) {
    ScrollTrigger.create({ trigger: quest, start: 'top 90%', end: 'bottom 10%', onUpdate: (self) => placeSun(self.progress) });
    ScrollTrigger.create({ trigger: garden, start: 'top 78%', once: true, onEnter: () => garden.classList.add('is-in') });
    if (fine) {
      const svg = $<SVGSVGElement>('svg', garden);
      garden.addEventListener('pointermove', (e) => {
        const m = svg.getScreenCTM();
        if (!m) return;
        const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
        cursor = { x: p.x, y: p.y };
        aim();
      });
      garden.addEventListener('pointerleave', () => {
        cursor = null;
        aim();
      });
    }
  }

  /* ---------- Scroll: pins, the sideways work rail, the red line ---------- */
  const threadSvg = $<SVGSVGElement>('[data-thread]');
  const steps = $$('[data-step]');
  const count = $('[data-count]');
  const panels = $$('[data-panel]');
  const scrollHint = $('[data-scroll-hint]');
  /** The button the line ends on: Send, or Send another once a message has gone. */
  const visibleEnd = () => $$('[data-end]').find((b) => b.offsetParent !== null) ?? $('[data-send]');
  let thread: Thread | null = null;

  const stepProgress = [0, 0, 0];
  const onStep = (i: number, p: number) => {
    stepProgress[i] = p;
    let on = 0;
    stepProgress.forEach((v, k) => v > 0 && (on = k));
    steps.forEach((s, k) => s.classList.toggle('is-on', k === on));
    ways[i].classList.toggle('is-done', p >= 0.999);
  };
  const onRail = (p: number) => {
    const at = p * (panels.length - 1);
    count.textContent = String(Math.min(panels.length, Math.round(at) + 1)).padStart(2, '0');
  };

  const mm = gsap.matchMedia();
  // A conditions object only runs when one of them matches, so 'all' keeps phones in.
  mm.add({ all: 'all', wide: '(min-width: 900px) and (min-height: 560px)', still: '(prefers-reduced-motion: reduce)' }, (ctx) => {
    const { wide, still } = ctx.conditions as { wide: boolean; still: boolean };
    const rail = wide && !still;
    work.classList.toggle('is-rail', rail);

    const heroPin = still
      ? null
      : ScrollTrigger.create({
          trigger: hero,
          start: 'top top',
          end: '+=90%',
          pin: true,
          scrub: true,
          onUpdate: (self) => {
            calmTo = self.progress;
            scrollHint.style.opacity = String(Math.max(0, 1 - self.progress * 6));
            hint.style.filter = `opacity(${Math.max(0, 1 - self.progress * 5)})`;
          },
        });
    const methodPin = still ? null : ScrollTrigger.create({ trigger: methodFrame, start: 'top top', end: '+=240%', pin: true });
    // The map is surveyed outward from the first waypoint as the method arrives.
    ScrollTrigger.create({ trigger: mapEl, start: 'top 85%', once: true, onEnter: () => mapEl.classList.add('is-in') });

    let workPin: ScrollTrigger | null = null;
    if (rail) {
      const distance = () => Math.max(0, track.scrollWidth - innerWidth);
      const slide = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: { trigger: workFrame, start: 'top top', end: () => `+=${distance()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true },
      });
      workPin = slide.scrollTrigger!;
      panels.forEach((panel) =>
        ScrollTrigger.create({ trigger: panel, containerAnimation: slide, start: 'left 78%', onEnter: () => panel.classList.add('is-in') }),
      );
    } else {
      panels.forEach((panel) => ScrollTrigger.create({ trigger: panel, start: 'top 82%', onEnter: () => panel.classList.add('is-in') }));
    }
    if (!still) ScrollTrigger.create({ trigger: legend, start: 'top 88%', end: 'bottom 45%', scrub: 0.6, onUpdate: (self) => key?.progress(self.progress) });
    // The pictograms put themselves together as each capability arrives.
    $$('[data-cap]').forEach((cap) => ScrollTrigger.create({ trigger: cap, start: 'top 85%', once: true, onEnter: () => cap.classList.add('is-in') }));

    const span = (st: ScrollTrigger | null, fallback: [number, number]) => (): [number, number] => (st ? [st.start, st.end] : fallback);
    const make = () => {
      thread = createThread({
        svg: threadSvg,
        still,
        start: () => -1,
        runs: buildRuns({
          wide: rail,
          lane: lane(),
          hero,
          origin: $('[data-origin]'),
          heroRange: span(heroPin, [0, 1]),
          intro,
          method,
          methodFrame,
          methodRange: span(methodPin, [0, 1]),
          map: mapEl,
          ways,
          work,
          workHead: $('[data-work-head]'),
          workFrame,
          workRange: workPin ? span(workPin, [0, 1]) : undefined,
          panels,
          range,
          rangeHead: $('[data-range-head]'),
          caps: $('[data-caps]'),
          also: $('[data-also]'),
          quest,
          contact,
          send: visibleEnd(),
          onStep,
          onRail,
        }),
      });
      thread.sync();
      thread.draw();
    };
    make();
    ScrollTrigger.addEventListener('refresh', make);
    return () => {
      ScrollTrigger.removeEventListener('refresh', make);
      thread = null;
    };
  });
  // The composition and the key are placed in shares of their boxes.
  ScrollTrigger.addEventListener('refresh', () => {
    setOrder();
    setKey();
  });

  addEventListener('resize', () => {
    measureCopy();
    terrain.resize();
    map.render();
    if (reduce) {
      // Nothing moves on its own: draw again only when the page changes.
      terrain.render();
      thread?.draw();
    }
  });
  if (reduce) addEventListener('scroll', () => thread?.draw(), { passive: true });

  /* ---------- One loop for everything that moves ---------- */
  let prev = performance.now();
  const loop = (now: number) => {
    const dt = Math.min(0.1, (now - prev) / 1000);
    prev = now;
    // The ground only while the hero is on screen (checked directly: pinning moves it around).
    const b = hero.getBoundingClientRect();
    if (b.bottom > 0 && b.top < innerHeight) {
      calm += (calmTo - calm) * (1 - Math.exp(-dt * 7));
      terrain.setCalm(calm);
      order?.progress(Math.min(1, calm / 0.85));
      terrain.frame(dt);
    }
    thread?.frame(dt);
    requestAnimationFrame(loop);
  };
  if (!reduce) requestAnimationFrame(loop);

  /* ---------- Type: reveals as things arrive ---------- */
  if (!reduce) {
    gsap.set('[data-fade]', { opacity: 0, y: 18 });
    SplitText.create('.hero-title', {
      type: 'lines',
      mask: 'lines',
      autoSplit: true,
      onSplit: (self) => gsap.from(self.lines, { yPercent: 125, duration: 1.4, ease: 'expo.out', stagger: 0.12, delay: 0.3 }),
    });
    gsap.to('[data-fade]', { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.1, delay: 0.75 });
    gsap.fromTo(hint, { opacity: 0 }, { opacity: 1, duration: 1, delay: 2.4 });

    $$('.sec-title[data-split]').forEach((el) =>
      SplitText.create(el, {
        type: 'lines',
        mask: 'lines',
        autoSplit: true,
        onSplit: (self) =>
          gsap.from(self.lines, { yPercent: 125, duration: 1.2, ease: 'expo.out', stagger: 0.1, scrollTrigger: { trigger: el, start: 'top 86%', once: true } }),
      }),
    );

    // The statement lights up word by word as it is read, and the underline follows.
    SplitText.create('[data-words]', {
      type: 'words',
      autoSplit: true,
      onSplit: (self) =>
        gsap.fromTo(
          self.words,
          { opacity: 0.14 },
          { opacity: 1, ease: 'none', stagger: 0.1, scrollTrigger: { trigger: '[data-words]', start: 'top 78%', end: 'bottom 50%', scrub: 0.5 } },
        ),
    });
    gsap.fromTo(
      '[data-mark]',
      { '--hl': 0 },
      { '--hl': 1, ease: 'none', scrollTrigger: { trigger: '[data-mark]', start: 'top 62%', end: 'bottom 50%', scrub: 0.5 } },
    );

    gsap.utils.toArray<HTMLElement>('.also, .quest-copy > :not(.sec-title), .contact-intro > :not(.sec-title), .contact-card').forEach((el) =>
      gsap.from(el, { y: 36, opacity: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 90%', once: true } }),
    );
  } else {
    $$<SVGSVGElement>('[data-diagram]').forEach((svg) => svg.pauseAnimations());
  }

  /* ---------- Diagrams: fit each chip to its label, light the nodes a decision is about ---------- */
  /** The glyph's share of a chip, and the padding after the label (as in Diagram.astro). */
  const GLYPH = 30;
  function fitDiagrams() {
    $$<SVGGElement>('.diagram .node').forEach((node) => {
      const text = node.querySelector('text')!;
      const chip = node.querySelector<SVGRectElement>('.chip')!;
      const w = Math.ceil(GLYPH + text.getComputedTextLength() + 12);
      chip.setAttribute('width', String(w));
      node.setAttribute('transform', `translate(${Number(node.dataset.cx) - w / 2} ${Number(node.dataset.cy) - 15})`);
    });
  }
  document.fonts.ready.then(() => {
    fitDiagrams();
    measureCopy();
    ScrollTrigger.refresh();
  });

  panels.forEach((card) => {
    const svg = $<SVGSVGElement>('[data-diagram]', card);
    const nodes = $$<SVGGElement>('.node', svg);
    const links = $$<SVGPathElement>('.link', svg);
    $$('[data-nodes]', card).forEach((li) => {
      const ids = li.dataset.nodes!.split(' ');
      const on = () => {
        svg.classList.add('is-focus');
        nodes.forEach((n) => n.classList.toggle('is-hot', ids.includes(n.dataset.node!)));
        links.forEach((l) => l.classList.toggle('is-hot', ids.includes(l.dataset.a!) || ids.includes(l.dataset.b!)));
        li.classList.add('is-on');
      };
      const off = () => {
        svg.classList.remove('is-focus');
        nodes.forEach((n) => n.classList.remove('is-hot'));
        links.forEach((l) => l.classList.remove('is-hot'));
        li.classList.remove('is-on');
      };
      li.addEventListener('pointerenter', on);
      li.addEventListener('pointerleave', () => document.activeElement !== li && off());
      li.addEventListener('focus', on);
      li.addEventListener('blur', off);
    });
  });

  /* ---------- Bar ---------- */
  const bar = $('[data-bar]');
  const onScroll = () => bar.classList.toggle('is-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ---------- Buttons lean toward the cursor (not the one the line ties round) ---------- */
  if (fine && !reduce) {
    $$('[data-magnet]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const b = el.getBoundingClientRect();
        gsap.to(el, { x: (e.clientX - (b.left + b.width / 2)) * 0.22, y: (e.clientY - (b.top + b.height / 2)) * 0.3, duration: 0.5, ease: 'power3.out' });
      });
      el.addEventListener('pointerleave', () => gsap.to(el, { x: 0, y: 0, duration: 0.9, ease: 'elastic.out(1, 0.4)' }));
    });
  }

  /* ---------- Contact ---------- */
  const form = $<HTMLFormElement>('[data-form]');
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const showError = (name: string, on: boolean) => {
    const err = $(`[data-error-for="${name}"]`, form);
    err.classList.toggle('is-on', on);
    field(name).setAttribute('aria-invalid', String(on));
    if (on) field(name).setAttribute('aria-describedby', err.id || (err.id = `${name}-error`));
  };
  const check = (name: string) => {
    const el = field(name);
    const ok = el.value.trim() !== '' && (el.type !== 'email' || el.checkValidity());
    showError(name, !ok);
    return ok;
  };
  for (const name of ['name', 'email', 'message']) field(name).addEventListener('blur', () => check(name));

  // Messages go to the enquiry Worker. Local development can point elsewhere.
  const ENDPOINT = import.meta.env.PUBLIC_ENQUIRY_URL || 'https://qwantarc.com/api/enquiry';
  const opened = performance.now();
  const send = $<HTMLButtonElement>('[data-send]', form);
  const sendLabel = $('[data-send-label]', form);
  const formHint = $('[data-form-hint]', form);
  const formHintText = formHint.textContent;
  const sent = $('[data-sent]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (send.disabled) return;
    if (['name', 'email', 'message'].map(check).includes(false)) {
      (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
      return;
    }
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const payload = {
      source: 'ethchor',
      topic: get('topic'),
      name: get('name'),
      email: get('email'),
      message: get('message'),
      website: get('website'),
      elapsed: Math.round(performance.now() - opened),
    };
    send.disabled = true;
    sendLabel.textContent = 'Sending…';
    formHint.classList.remove('is-error');
    formHint.textContent = formHintText;
    try {
      const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const out = await res.json().catch(() => ({ ok: false }));
      if (!res.ok || !out.ok) throw new Error(out.error || 'Couldn’t send right now. Try again in a minute.');
      $('[data-sent-name]').textContent = `, ${payload.name.split(' ')[0]}`;
      $('[data-sent-email]').textContent = payload.email;
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
      // The line finds the new button and ties itself round it.
      ScrollTrigger.refresh();
    } catch (err) {
      const msg = err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'Couldn’t reach the server. Check your connection and try again.';
      formHint.classList.add('is-error');
      formHint.textContent = `${msg} You can also reach me on LinkedIn.`;
    } finally {
      send.disabled = false;
      sendLabel.textContent = 'Send';
    }
  });
  $('[data-again]').addEventListener('click', () => {
    form.reset();
    sent.hidden = true;
    form.hidden = false;
    field('name').focus();
    ScrollTrigger.refresh();
  });
</script>
