---
import { render } from 'astro:content';
import QigLayout from '../../../layouts/QigLayout.astro';
import QigArt from '../../../components/QigArt.astro';
import { FIRST_PUBLISHED, QIG_BASE, QIG_NAME, getNav, pageUrl, type NavSection, type QigPage } from '../../../lib/qig';

export async function getStaticPaths() {
  const nav = await getNav();
  return [
    ...nav.map((section) => ({ params: { slug: section.id }, props: { sectionId: section.id, page: undefined } })),
    ...nav.flatMap((section) => section.pages.map((page) => ({ params: { slug: page.id }, props: { sectionId: section.id, page } }))),
  ];
}

interface Props {
  sectionId: string;
  page?: QigPage;
}

const { sectionId, page } = Astro.props;
const nav = await getNav();
const section = nav.find((s) => s.id === sectionId) as NavSection;

/** Summaries are one line of Markdown: code spans and links only. */
const inlineMarkdown = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');

let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let prev: QigPage | undefined;
let next: QigPage | undefined;
if (page) {
  ({ Content } = await render(page));
  const i = section.pages.findIndex((p) => p.id === page.id);
  prev = section.pages[i - 1];
  next = section.pages[i + 1];
}
const sectionCrumbs = [
  { label: 'QIG', href: QIG_BASE },
  { label: section.title, href: pageUrl(section.id) },
];
---

{
  !page ? (
    <QigLayout
      title={`${section.title} | ${QIG_NAME}`}
      description={section.summary}
      current={section.id}
      crumbs={[{ label: 'QIG', href: QIG_BASE }, { label: section.title }]}
    >
      <header class="page-hero is-wide">
        <QigArt seed={section.id} bend />
        <div class="page-hero-copy">
          <p class="eyebrow">
            <span class="num">{section.num}</span>
            <a href={QIG_BASE}>Interface Guidelines</a>
          </p>
          <h1 class="page-title">{section.title}</h1>
        </div>
      </header>
      <div class="overview-body">
        <p class="lede">{section.summary}</p>
        {section.groups.map((group, gi) => (
          <section>
            {group.title && (
              <h2 class="section-title">
                <span class="num">{section.num}.{String(gi + 1).padStart(2, '0')}</span>
                {group.title}
              </h2>
            )}
            <ul class="cards">
              {group.pages.map((p) => (
                <li>
                  <a class="card" href={pageUrl(p.id)}>
                    <QigArt seed={p.id} ratio={2} />
                    <div class="card-body">
                      <h3 class="card-title">{p.data.title}</h3>
                      {p.data.summary && <p class="card-text">{p.data.summary.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')}</p>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </QigLayout>
  ) : (
    Content && (
      <QigLayout
        title={`${page.data.title} | ${QIG_NAME}`}
        description={page.data.summary ?? section.summary}
        current={page.id}
        crumbs={[...sectionCrumbs, { label: page.data.title }]}
      >
        <article class="article">
          <header class="page-hero">
            <QigArt seed={page.id} bend />
            <div class="page-hero-copy">
              <p class="eyebrow">
                <span class="num">{section.num}</span>
                <a href={pageUrl(section.id)}>{section.title}</a>
                {page.data.group && <span>/ {page.data.group}</span>}
              </p>
              <h1 class="page-title">{page.data.title}</h1>
            </div>
          </header>
          <div class="article-body">
            {page.data.summary && <p class="lede" set:html={inlineMarkdown(page.data.summary)} />}
            <div class="prose">
              <Content />
            </div>
          </div>
          <footer class="article-foot">
            {(prev || next) && (
              <>
                <h2 class="foot-title">Keep reading</h2>
                <ul class="related">
                  {prev && (
                    <li>
                      <a href={pageUrl(prev.id)}>
                        <span class="k">Previous</span>
                        <span class="t">{prev.data.title}</span>
                      </a>
                    </li>
                  )}
                  {next && (
                    <li>
                      <a href={pageUrl(next.id)}>
                        <span class="k">Next</span>
                        <span class="t">{next.data.title}</span>
                      </a>
                    </li>
                  )}
                  <li>
                    <a href={pageUrl(section.id)}>
                      <span class="k">All of</span>
                      <span class="t">{section.title}</span>
                    </a>
                  </li>
                </ul>
              </>
            )}
            {page.id !== 'whats-new' && (
              <>
                <h2 class="foot-title">Change log</h2>
                <table class="changelog">
                  <thead>
                    <tr>
                      <th scope="col">Date</th>
                      <th scope="col">Changes</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>{FIRST_PUBLISHED}</td>
                      <td>First published.</td>
                    </tr>
                  </tbody>
                </table>
              </>
            )}
          </footer>
        </article>
      </QigLayout>
    )
  )
}
