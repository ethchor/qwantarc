---
import { getEntry } from 'astro:content';
import QigLayout from '../../../layouts/QigLayout.astro';
import QigArt from '../../../components/QigArt.astro';
import { QIG_NAME, getNav, pageUrl } from '../../../lib/qig';

const nav = await getNav();
const principlesPage = await getEntry('qig', 'principles');
const principles = [...(principlesPage?.body ?? '').matchAll(/^## \d+\. (.+)\n\n(.+)$/gm)].map((m) => ({
  title: m[1],
  text: m[2],
}));
const description =
  'Qwantarc Interface Guidelines (QIG): the principles, foundations, patterns and components behind every Qwantarc product.';
const start = ['principles', 'rules', 'designing-a-screen', 'colour', 'materials', 'buttons'];
const all = nav.flatMap((s) => s.pages.map((p) => ({ p, s })));
const featured = start.map((id) => all.find((x) => x.p.id === id)).filter((x) => x !== undefined);
const strip = (text?: string) => text?.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
---

<QigLayout title={QIG_NAME} description={description} current="home" crumbs={[{ label: 'QIG' }]}>
  <header class="page-hero is-tall is-wide">
    <QigArt seed="qwantarc-interface-guidelines" ratio={2.2} bend />
    <div class="page-hero-copy">
      <p class="eyebrow"><span class="num">QIG</span> Qwantarc</p>
      <h1 class="page-title">Interface Guidelines</h1>
    </div>
  </header>

  <div class="overview-body">
    <p class="lede">
      How Qwantarc designs software people rely on all day: the ideas behind every screen, the foundations they share,
      the patterns that repeat and the components they’re built from, on any platform and in any technology.
    </p>
    <div class="actions">
      <a class="button" href={pageUrl('getting-started')}>Get Started</a>
      <a class="button is-secondary" href={pageUrl('whats-new')}>What’s New</a>
    </div>

    <h2 class="section-title">Principles</h2>
    <p class="section-sub">When a rule doesn’t cover a case, these decide it.</p>
    <ol class="principles">
      {
        principles.map((p) => (
          <li>
            <strong>{p.title}</strong>
            <span>{p.text}</span>
          </li>
        ))
      }
    </ol>

    <h2 class="section-title">The guidelines</h2>
    <p class="section-sub">{nav.reduce((n, s) => n + s.pages.length, 0)} pages in five sections.</p>
    <ul class="cards is-large">
      {
        nav.map((section) => (
          <li>
            <a class="card" href={pageUrl(section.id)}>
              <QigArt seed={section.id} ratio={2} />
              <div class="card-body">
                <span class="card-num">{section.num}</span>
                <h3 class="card-title">{section.title}</h3>
                <p class="card-text">{section.summary}</p>
                <p class="card-meta">{section.pages.length} pages</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="section-title">Start here</h2>
    <p class="section-sub">The pages most people read first.</p>
    <ul class="cards">
      {
        featured.map(({ p, s }) => (
          <li>
            <a class="card" href={pageUrl(p.id)}>
              <QigArt seed={p.id} ratio={2} />
              <div class="card-body">
                <span class="card-num">
                  {s.num} / {s.title}
                </span>
                <h3 class="card-title">{p.data.title}</h3>
                {p.data.summary && <p class="card-text">{strip(p.data.summary)}</p>}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</QigLayout>
