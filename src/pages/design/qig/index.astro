---
import { getEntry } from 'astro:content';
import QigLayout from '../../../layouts/QigLayout.astro';
import QigArt from '../../../components/QigArt.astro';
import { QIG_NAME, getNav, pageUrl } from '../../../lib/qig';

const nav = await getNav();
const principlesPage = await getEntry('qig', 'principles');
const principles = [...(principlesPage?.body ?? '').matchAll(/^## \d+\. (.+)\n\n(.+)$/gm)].map((m) => ({
  title: m[1],
  text: m[2],
}));
const description =
  'Qwantarc’s Interface Guidelines (QIG): the principles, foundations, patterns and components behind every Qwantarc product.';
const start = ['principles', 'rules', 'designing-a-screen', 'colour', 'materials', 'buttons'];
const featured = start.map((id) => nav.flatMap((s) => s.pages.map((p) => ({ p, s }))).find((x) => x.p.id === id)).filter(Boolean);
---

<QigLayout title={QIG_NAME} description={description} current="home" crumbs={[{ label: 'QIG' }]}>
  <div class="article-hero">
    <QigArt seed="qwantarc-interface-guidelines" colors={['#0a0a0c', '#1e6ef4']} ratio={2.4} />
  </div>
  <div class="overview">
    <header class="overview-head">
      <p class="eyebrow">Design</p>
      <h1 class="title">{QIG_NAME}</h1>
      <p class="lede">
        QIG is how Qwantarc designs software people rely on all day. It describes the ideas behind every screen, the
        foundations they share, the patterns that repeat and the components they are built from, on any platform and in
        any technology.
      </p>
      <div class="actions">
        <a class="button" href={pageUrl('getting-started')}>Get Started</a>
        <a class="button is-secondary" href={pageUrl('whats-new')}>What’s New</a>
      </div>
    </header>

    <h2 class="section-title">Principles</h2>
    <p class="section-sub">When a rule doesn’t cover a case, these decide it.</p>
    <ol class="principles">
      {
        principles.map((p) => (
          <li>
            <strong>{p.title}</strong>
            <span>{p.text}</span>
          </li>
        ))
      }
    </ol>

    <h2 class="section-title">Explore the guidelines</h2>
    <p class="section-sub">{nav.reduce((n, s) => n + s.pages.length, 0)} pages in five sections.</p>
    <ul class="cards is-large">
      {
        nav.map((section) => (
          <li>
            <a class="card" href={pageUrl(section.id)}>
              <QigArt seed={section.id} colors={section.colors} ratio={1.9} />
              <div class="card-body">
                <h3 class="card-title">{section.title}</h3>
                <p class="card-text">{section.summary}</p>
                <p class="card-meta">
                  {section.pages.length} {section.pages.length === 1 ? 'page' : 'pages'}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="section-title">Start here</h2>
    <p class="section-sub">The pages most people read first.</p>
    <ul class="cards">
      {
        featured.map((x) => (
          <li>
            <a class="card" href={pageUrl(x!.p.id)}>
              <QigArt seed={x!.p.id} colors={x!.s.colors} ratio={1.9} />
              <div class="card-body">
                <h3 class="card-title">{x!.p.data.title}</h3>
                {x!.p.data.summary && <p class="card-text">{x!.p.data.summary.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')}</p>}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</QigLayout>

<style>
  .title {
    margin: 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.032em;
  }
</style>
