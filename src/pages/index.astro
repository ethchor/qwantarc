---
import Base from '../layouts/Base.astro';
import '../styles/brand.css';

const TAGLINE = 'Everything we build, from cognition to comfort, follows the intelligent arc.';
const WORD = 'Qwantarc';
const EMAIL = 'vimu@qwantarc.com';
const manifesto = 'Everything we build, from *cognition* to *comfort,* follows the intelligent arc.'.split(' ');
const stages = [
  {
    n: '01',
    word: 'Cognition',
    text: 'It begins with understanding. Systems that notice, learn and think a step ahead, so people don’t have to.',
  },
  {
    n: '02',
    word: 'Craft',
    text: 'Then the making. Every detail considered, every motion earned, nothing added for show.',
  },
  {
    n: '03',
    word: 'Comfort',
    text: 'And it ends in ease. Technology that feels like it was always there, quiet until it’s needed.',
  },
];
---

<Base title="Qwantarc" description={TAGLINE} origin="https://qwantarc.com" themeColor="#0a0a09" fonts="brand">
  <div class="grain" aria-hidden="true"></div>

  <header class="bar">
    <a class="bar-mark" href="/" aria-label="Qwantarc, home">Qwantarc</a>
    <div class="bar-end">
      <span class="bar-index" aria-hidden="true"><span data-index>01</span><span class="bar-sep">/</span>04</span>
      <a class="bar-link" href="/contact">Contact</a>
    </div>
  </header>

  <main>
    <section class="hero" data-hero aria-labelledby="mark">
      <canvas class="field" data-field aria-hidden="true"></canvas>
      <div class="hero-center">
        <h1 id="mark" class="mark" aria-label={WORD}>
          {
            [...WORD].map((ch) => (
              <span class="mark-clip" aria-hidden="true">
                <span class="mark-ch">{ch}</span>
              </span>
            ))
          }
        </h1>
      </div>
      <p class="corner corner-l" data-fade>From cognition<br />to comfort</p>
      <p class="corner corner-r" data-fade>Move to bend the arc<span class="pulse" aria-hidden="true"></span></p>
    </section>

    <section class="manifesto" data-section="02" aria-label="What we believe">
      <p class="manifesto-text" data-words>
        {
          manifesto.map((w) => {
            const text = w.replace(/\*/g, '');
            return w.startsWith('*') ? <em class="w">{text} </em> : <span class="w">{text} </span>;
          })
        }
      </p>
    </section>

    <section class="journey" data-journey data-section="03" aria-label="The arc">
      <div class="journey-stick">
        <svg class="journey-svg" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <path class="track" d="M 140 820 A 700 640 0 0 1 1460 820"></path>
          <path class="trace" d="M 140 820 A 700 640 0 0 1 1460 820" data-trace></path>
          <g data-ticks></g>
          <circle class="probe-halo" r="26" data-halo></circle>
          <circle class="probe" r="7" data-probe></circle>
        </svg>
        <div class="stages">
          {
            stages.map((s, i) => (
              <article class="stage" data-stage={i}>
                <p class="stage-n">{s.n}</p>
                <h2 class="stage-word">{s.word}</h2>
                <p class="stage-text">{s.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="hello" data-section="04" aria-labelledby="hello-title">
      <p class="hello-n">04</p>
      <h2 id="hello-title" class="hello-title">Say <em>hello.</em></h2>
      <p class="hello-text">Partnerships, products, or just an idea worth building. Write to us and a person reads it.</p>
      <a class="hello-mail" href={`mailto:${EMAIL}`} data-magnet>
        <span>{EMAIL}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="hello-link" href="/contact">Start an enquiry</a>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-row">
      <span>© {new Date().getFullYear()} Qwantarc</span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <span>Everything follows the arc.</span>
    </div>
    <p class="foot-mark" aria-hidden="true">Qwantarc</p>
  </footer>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  /* ---------- The field: concentric arcs that bend toward the pointer ---------- */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-field]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const ctx = canvas.getContext('2d')!;
  let W = 0;
  let H = 0;
  let dpr = 1;
  const pointer = { x: 0, y: 0, tx: 0, ty: 0, active: false };
  const state = { intro: reduce ? 1 : 0 };
  let arcs: { r: number; n: number }[] = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = hero.clientWidth;
    H = hero.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = `${W}px`;
    canvas.style.height = `${H}px`;
    const maxR = Math.hypot(W, H) * 1.05;
    arcs = [];
    let r = H * 0.22;
    let gap = 9;
    while (r < maxR) {
      arcs.push({ r, n: Math.max(48, Math.round((Math.PI * r) / 12)) });
      r += gap;
      gap *= 1.045;
    }
    if (!pointer.active) {
      pointer.x = pointer.tx = W / 2;
      pointer.y = pointer.ty = H * 0.42;
    }
  }

  const BONE = '236 233 227';
  const EMBER = '255 112 67';

  function draw(t: number) {
    const cx = W / 2;
    const cy = H * 1.16;
    if (!pointer.active) {
      pointer.tx = W / 2 + Math.sin(t * 0.00021) * W * 0.32;
      pointer.ty = H * 0.42 + Math.cos(t * 0.00016) * H * 0.18;
    }
    pointer.x += (pointer.tx - pointer.x) * 0.075;
    pointer.y += (pointer.ty - pointer.y) * 0.075;

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const sigma = Math.min(W, H) * 0.2;
    const pull = 0.42;
    const pr = Math.hypot(pointer.x - cx, pointer.y - cy);
    const span = (Math.PI / 2) * state.intro;
    const breathe = reduce ? 0 : t * 0.0004;

    for (let i = 0; i < arcs.length; i++) {
      const { r: r0, n } = arcs[i];
      const r = r0 + Math.sin(breathe + i * 0.33) * 1.6;
      const near = Math.exp(-((r - pr) ** 2) / (2 * (sigma * 0.35) ** 2));
      const next = arcs[i + 1]?.r ?? r0 + 20;
      const chosen = pr >= r0 && pr < next;
      ctx.beginPath();
      for (let k = 0; k <= n; k++) {
        const a = Math.PI * 1.5 - span + (2 * span * k) / n;
        let x = cx + Math.cos(a) * r;
        let y = cy + Math.sin(a) * r;
        const dx = pointer.x - x;
        const dy = pointer.y - y;
        const f = pull * Math.exp(-(dx * dx + dy * dy) / (2 * sigma * sigma));
        x += dx * f;
        y += dy * f;
        if (k === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      if (chosen && state.intro > 0.98) {
        ctx.strokeStyle = `rgb(${EMBER} / 0.95)`;
        ctx.lineWidth = 1.6;
        ctx.shadowColor = `rgb(${EMBER} / 0.7)`;
        ctx.shadowBlur = 14;
      } else {
        const depth = 1 - i / arcs.length;
        ctx.strokeStyle = `rgb(${BONE} / ${0.07 + depth * 0.1 + near * 0.32})`;
        ctx.lineWidth = 1;
        ctx.shadowBlur = 0;
      }
      ctx.stroke();
    }
    ctx.shadowBlur = 0;
  }

  let running = false;
  let raf = 0;
  const loop = (t: number) => {
    draw(t);
    raf = requestAnimationFrame(loop);
  };
  const start = () => {
    if (running || reduce) return;
    running = true;
    raf = requestAnimationFrame(loop);
  };
  const stop = () => {
    running = false;
    cancelAnimationFrame(raf);
  };

  resize();
  draw(0);
  new ResizeObserver(() => {
    resize();
    if (!running) draw(performance.now());
  }).observe(hero);
  new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(hero);

  /* ---------- Wordmark: weight follows the pointer ---------- */
  const letters = [...document.querySelectorAll<HTMLElement>('.mark-ch')];
  const weights = letters.map(() => 700);
  let mx = 0;
  let my = 0;

  if (finePointer) {
    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      pointer.active = true;
      pointer.tx = e.clientX - rect.left;
      pointer.ty = e.clientY - rect.top;
      mx = e.clientX;
      my = e.clientY;
    });
    hero.addEventListener('pointerleave', () => (pointer.active = false));
  }
  if (finePointer && !reduce) {
    const tick = () => {
      if (running) {
        letters.forEach((el, i) => {
          let target = 700;
          if (pointer.active) {
            const b = el.getBoundingClientRect();
            const d = Math.hypot(mx - (b.left + b.width / 2), my - (b.top + b.height / 2));
            target = 220 + 680 * Math.exp(-(d * d) / (2 * 170 * 170));
          }
          weights[i] += (target - weights[i]) * 0.12;
          el.style.fontVariationSettings = `'wght' ${weights[i].toFixed(0)}`;
        });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  /* ---------- Intro ---------- */
  if (!reduce) {
    gsap.set('.mark-ch', { yPercent: 110 });
    gsap.set('[data-fade]', { opacity: 0 });
    gsap
      .timeline({ delay: 0.15 })
      .to(state, { intro: 1, duration: 2.2, ease: 'expo.inOut' }, 0)
      .to('.mark-ch', { yPercent: 0, duration: 1.3, ease: 'expo.out', stagger: 0.055 }, 0.55)
      .to('[data-fade]', { opacity: 1, duration: 1, stagger: 0.12 }, 1.5);
  }

  /* ---------- Manifesto: words light up as you read ---------- */
  if (!reduce) {
    gsap.fromTo(
      '[data-words] .w',
      { opacity: 0.12 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.12,
        scrollTrigger: { trigger: '[data-words]', start: 'top 78%', end: 'bottom 42%', scrub: 0.6 },
      },
    );
  }

  /* ---------- Journey: a point travels the arc ---------- */
  const trace = document.querySelector<SVGPathElement>('[data-trace]')!;
  const probe = document.querySelector<SVGCircleElement>('[data-probe]')!;
  const halo = document.querySelector<SVGCircleElement>('[data-halo]')!;
  const ticks = document.querySelector<SVGGElement>('[data-ticks]')!;
  const stageEls = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const len = trace.getTotalLength();
  const stops = [0.06, 0.5, 0.94];
  stops.forEach((s) => {
    const p = trace.getPointAtLength(len * s);
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', String(p.x));
    c.setAttribute('cy', String(p.y));
    c.setAttribute('r', '4');
    c.setAttribute('class', 'tick');
    ticks.appendChild(c);
  });
  const tickEls = [...ticks.querySelectorAll('circle')];
  trace.style.strokeDasharray = `${len}`;

  let current = -1;
  function setProgress(p: number) {
    trace.style.strokeDashoffset = `${len * (1 - p)}`;
    const pt = trace.getPointAtLength(len * p);
    for (const el of [probe, halo]) {
      el.setAttribute('cx', String(pt.x));
      el.setAttribute('cy', String(pt.y));
    }
    tickEls.forEach((t, i) => t.classList.toggle('is-on', p >= stops[i] - 0.01));
    const idx = p < 0.33 ? 0 : p < 0.72 ? 1 : 2;
    if (idx !== current) {
      current = idx;
      stageEls.forEach((el, i) => el.classList.toggle('is-active', i === idx));
    }
  }

  if (reduce) {
    setProgress(1);
    stageEls.forEach((el) => el.classList.add('is-active'));
  } else {
    setProgress(0);
    ScrollTrigger.create({
      trigger: '[data-journey]',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 0.8,
      onUpdate: (self) => setProgress(self.progress),
    });
  }

  /* ---------- Contact: the email button leans toward the pointer ---------- */
  const magnet = document.querySelector<HTMLElement>('[data-magnet]');
  if (magnet && finePointer && !reduce) {
    magnet.addEventListener('pointermove', (e) => {
      const b = magnet.getBoundingClientRect();
      gsap.to(magnet, {
        x: (e.clientX - (b.left + b.width / 2)) * 0.25,
        y: (e.clientY - (b.top + b.height / 2)) * 0.35,
        duration: 0.6,
        ease: 'power3.out',
      });
    });
    magnet.addEventListener('pointerleave', () => gsap.to(magnet, { x: 0, y: 0, duration: 0.9, ease: 'elastic.out(1, 0.4)' }));
  }

  /* ---------- Index in the bar ---------- */
  const index = document.querySelector<HTMLElement>('[data-index]')!;
  ScrollTrigger.create({
    trigger: '[data-hero]',
    start: 'top top',
    end: 'bottom 50%',
    onToggle: (s) => s.isActive && (index.textContent = '01'),
  });
  document.querySelectorAll<HTMLElement>('[data-section]').forEach((el) =>
    ScrollTrigger.create({
      trigger: el,
      start: 'top 50%',
      end: 'bottom 50%',
      onToggle: (s) => s.isActive && (index.textContent = el.dataset.section!),
    }),
  );
</script>


<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    cursor: crosshair;
  }
  .field {
    position: absolute;
    inset: 0;
  }
  .hero-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .mark {
    display: flex;
    margin: 0;
    font-size: clamp(64px, 17.5vw, 300px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--bone);
    transform: translateY(-4%);
  }
  .mark-clip {
    display: inline-block;
    overflow: hidden;
    padding: 0.06em 0.005em 0.14em;
    margin-bottom: -0.14em;
  }
  .mark-ch {
    display: inline-block;
    font-variation-settings: 'wght' 700;
  }
  .corner {
    position: absolute;
    bottom: clamp(20px, 3.4vw, 40px);
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--bone-2);
  }
  .corner-l {
    left: clamp(18px, 3.4vw, 44px);
  }
  .corner-r {
    right: clamp(18px, 3.4vw, 44px);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 rgb(255 112 67 / 0.6);
    }
    to {
      box-shadow: 0 0 0 12px rgb(255 112 67 / 0);
    }
  }
  @media (pointer: coarse) {
    .corner-r {
      display: none;
    }
  }

  /* ---- Manifesto ---- */
  .manifesto {
    display: grid;
    place-items: center;
    min-height: 120vh;
    padding: 20vh clamp(18px, 6vw, 96px);
  }
  .manifesto-text {
    max-width: 17ch;
    margin: 0;
    font-size: clamp(38px, 6.6vw, 112px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .manifesto-text em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ember);
  }

  /* ---- Journey ---- */
  .journey {
    position: relative;
    height: 340vh;
  }
  .journey-stick {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .journey-svg {
    position: absolute;
    left: 50%;
    bottom: 2vh;
    width: min(94vw, 1500px);
    transform: translateX(-50%);
    overflow: visible;
  }
  .track {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .trace {
    fill: none;
    stroke: var(--ember);
    stroke-width: 2.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 10px rgb(255 112 67 / 0.55));
  }
  .journey-svg :global(.tick) {
    fill: var(--ink);
    stroke: var(--bone-3);
    stroke-width: 1.5;
    transition:
      fill 0.4s,
      stroke 0.4s;
  }
  .journey-svg :global(.tick.is-on) {
    fill: var(--ember);
    stroke: var(--ember);
  }
  .probe {
    fill: var(--bone);
  }
  .probe-halo {
    fill: none;
    stroke: rgb(236 233 227 / 0.3);
    stroke-width: 1;
  }
  .stages {
    position: relative;
    display: grid;
    width: min(680px, calc(100vw - 36px));
    text-align: center;
    transform: translateY(-10vh);
  }
  .stage {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stage.is-active {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .stage-n {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--ember);
    font-variant-numeric: tabular-nums;
  }
  .stage-word {
    margin: 10px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(64px, 11vw, 176px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .stage-text {
    max-width: 34ch;
    margin: 22px auto 0;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
    color: var(--bone-2);
  }

  /* ---- Contact ---- */
  .hello {
    display: grid;
    justify-items: center;
    gap: 0;
    padding: 18vh clamp(18px, 6vw, 96px) 22vh;
    text-align: center;
  }
  .hello-n {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--ember);
  }
  .hello-title {
    margin: 14px 0 0;
    font-size: clamp(56px, 10vw, 168px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .hello-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ember);
  }
  .hello-text {
    max-width: 30ch;
    margin: 28px 0 0;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--bone-2);
  }
  .hello-mail {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 48px;
    padding: 18px 30px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: clamp(20px, 2.6vw, 34px);
    font-weight: 400;
    letter-spacing: -0.02em;
    transition:
      background 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
    will-change: transform;
  }
  .hello-mail svg {
    width: 0.9em;
    height: 0.9em;
    transition: transform 0.4s var(--ease);
  }
  .hello-mail:hover {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--ink);
  }
  .hello-mail:hover svg {
    transform: translate(3px, -3px);
  }
  .hello-link {
    margin-top: 22px;
    font-size: 15px;
    color: var(--bone-2);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .hello-link:hover {
    color: var(--bone);
    border-color: var(--ember);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
    .journey {
      height: auto;
    }
    .journey-stick {
      position: relative;
      height: auto;
      padding: 12vh 0 40vh;
    }
    .stages {
      gap: 64px;
      transform: none;
    }
    .stage {
      grid-area: auto;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
