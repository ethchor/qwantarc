---
import Base from '../layouts/Base.astro';
import '../styles/brand.css';

const TAGLINE = 'Everything we build, from cognition to comfort, follows the intelligent arc.';
const WORD = 'Qwantarc';
const EMAIL = 'vimu@qwantarc.com';
const manifesto = 'Everything we build, from *cognition* to *comfort,* follows the intelligent arc.'.split(' ');
const stages = [
  {
    n: '01',
    word: 'Cognition',
    text: 'It begins with understanding. Systems that notice, learn and think a step ahead, so people don’t have to.',
  },
  {
    n: '02',
    word: 'Craft',
    text: 'Then the making. Every detail considered, every motion earned, nothing added for show.',
  },
  {
    n: '03',
    word: 'Comfort',
    text: 'And it ends in ease. Technology that feels like it was always there, quiet until it’s needed.',
  },
];
---

<Base title="Qwantarc" description={TAGLINE} origin="https://qwantarc.com" themeColor="#0a0a09" fonts="brand">
  <div class="grain" aria-hidden="true"></div>

  <header class="bar">
    <a class="bar-mark" href="/" aria-label="Qwantarc, home">Qwantarc</a>
    <div class="bar-end">
      <span class="bar-index" aria-hidden="true"><span data-index>01</span><span class="bar-sep">/</span>04</span>
      <a class="bar-link" href="/contact">Contact</a>
    </div>
  </header>

  <main>
    <section class="hero" data-hero aria-labelledby="mark">
      <canvas class="field" data-field aria-hidden="true"></canvas>
      <div class="hero-center">
        <h1 id="mark" class="mark" aria-label={WORD}>
          {
            [...WORD].map((ch) => (
              <span class="mark-clip" aria-hidden="true">
                <span class="mark-ch">{ch}</span>
              </span>
            ))
          }
        </h1>
      </div>
      <p class="corner corner-l" data-fade>From cognition<br />to comfort</p>
      <p class="corner corner-r" data-fade>
        <span class="hint-mouse">Move to bend the arc</span><span class="hint-touch">Touch to bend the arc</span><span class="pulse" aria-hidden="true"></span>
      </p>
    </section>

    <section class="manifesto" data-section="02" aria-label="What we believe">
      <p class="manifesto-text" data-words>
        {
          manifesto.map((w) => {
            const text = w.replace(/\*/g, '');
            return w.startsWith('*') ? <em class="w">{text} </em> : <span class="w">{text} </span>;
          })
        }
      </p>
    </section>

    <section class="journey" data-journey data-section="03" aria-label="The arc">
      <div class="journey-stick">
        <canvas class="journey-canvas" data-journey-canvas aria-hidden="true"></canvas>
        <div class="stages">
          {
            stages.map((s, i) => (
              <article class="stage" data-stage={i}>
                <p class="stage-n">{s.n}</p>
                <h2 class="stage-word">{s.word}</h2>
                <p class="stage-text">{s.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="hello" data-section="04" aria-labelledby="hello-title">
      <p class="hello-n">04</p>
      <h2 id="hello-title" class="hello-title">Say <em>hello.</em></h2>
      <p class="hello-text">Partnerships, products, or just an idea worth building. Write to us and a person reads it.</p>
      <a class="hello-cta" href="/contact" data-magnet>
        <span>Start an Enquiry</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-row">
      <span>© {new Date().getFullYear()} Qwantarc</span>
      <span class="foot-mail">{EMAIL}</span>
      <a class="foot-dev" href="https://developer.qwantarc.com">Developer<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
      <span>Everything follows the arc.</span>
    </div>
    <p class="foot-mark" aria-hidden="true">Qwantarc</p>
  </footer>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  /* ---------- The field: concentric arcs that bend toward the pointer ---------- */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-field]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const ctx = canvas.getContext('2d')!;
  let W = 0;
  let H = 0;
  let dpr = 1;
  const pointer = { x: 0, y: 0, tx: 0, ty: 0, active: false, touch: false };
  const state = { intro: reduce ? 1 : 0 };
  let arcs: { r: number; n: number }[] = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = hero.clientWidth;
    H = hero.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = `${W}px`;
    canvas.style.height = `${H}px`;
    const maxR = Math.hypot(W, H) * 1.05;
    arcs = [];
    let r = H * 0.22;
    let gap = 9;
    while (r < maxR) {
      arcs.push({ r, n: Math.max(48, Math.round((Math.PI * r) / 12)) });
      r += gap;
      gap *= 1.045;
    }
    if (!pointer.active) {
      pointer.x = pointer.tx = W / 2;
      pointer.y = pointer.ty = H * 0.42;
    }
  }

  /** Taps and clicks send a ring outward through the field. */
  const ripples: { x: number; y: number; t0: number }[] = [];
  const RIPPLE_LIFE = 1800;

  const BONE = '236 233 227';
  const EMBER = '255 112 67';

  function draw(t: number) {
    const cx = W / 2;
    const cy = H * 1.16;
    if (!pointer.active) {
      pointer.tx = W / 2 + Math.sin(t * 0.00021) * W * 0.32;
      pointer.ty = H * 0.42 + Math.cos(t * 0.00016) * H * 0.18;
    }
    const ease = pointer.touch ? 0.14 : 0.075;
    pointer.x += (pointer.tx - pointer.x) * ease;
    pointer.y += (pointer.ty - pointer.y) * ease;
    while (ripples.length && t - ripples[0].t0 > RIPPLE_LIFE) ripples.shift();
    const rings = ripples.map((rp) => {
      const age = (t - rp.t0) / 1000;
      return { x: rp.x, y: rp.y, R: age * Math.max(W, H) * 0.75, amp: 30 * Math.exp(-age * 2.4) };
    });

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const sigma = Math.min(W, H) * 0.2;
    const pull = 0.42;
    const pr = Math.hypot(pointer.x - cx, pointer.y - cy);
    const span = (Math.PI / 2) * state.intro;
    const breathe = reduce ? 0 : t * 0.0004;

    for (let i = 0; i < arcs.length; i++) {
      const { r: r0, n } = arcs[i];
      const r = r0 + Math.sin(breathe + i * 0.33) * 1.6;
      const near = Math.exp(-((r - pr) ** 2) / (2 * (sigma * 0.35) ** 2));
      const next = arcs[i + 1]?.r ?? r0 + 20;
      const chosen = pr >= r0 && pr < next;
      ctx.beginPath();
      for (let k = 0; k <= n; k++) {
        const a = Math.PI * 1.5 - span + (2 * span * k) / n;
        let x = cx + Math.cos(a) * r;
        let y = cy + Math.sin(a) * r;
        const dx = pointer.x - x;
        const dy = pointer.y - y;
        const f = pull * Math.exp(-(dx * dx + dy * dy) / (2 * sigma * sigma));
        x += dx * f;
        y += dy * f;
        for (const ring of rings) {
          const rx = x - ring.x;
          const ry = y - ring.y;
          const d = Math.hypot(rx, ry) || 1;
          const push = ring.amp * Math.exp(-((d - ring.R) ** 2) / 3200);
          x += (rx / d) * push;
          y += (ry / d) * push;
        }
        if (k === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      if (chosen && state.intro > 0.98) {
        ctx.strokeStyle = `rgb(${EMBER} / 0.95)`;
        ctx.lineWidth = 1.6;
        ctx.shadowColor = `rgb(${EMBER} / 0.7)`;
        ctx.shadowBlur = 14;
      } else {
        const depth = 1 - i / arcs.length;
        ctx.strokeStyle = `rgb(${BONE} / ${0.07 + depth * 0.1 + near * 0.32})`;
        ctx.lineWidth = 1;
        ctx.shadowBlur = 0;
      }
      ctx.stroke();
    }
    ctx.shadowBlur = 0;
  }

  let running = false;
  let raf = 0;
  const loop = (t: number) => {
    draw(t);
    raf = requestAnimationFrame(loop);
  };
  const start = () => {
    if (running || reduce) return;
    running = true;
    raf = requestAnimationFrame(loop);
  };
  const stop = () => {
    running = false;
    cancelAnimationFrame(raf);
  };

  resize();
  draw(0);
  new ResizeObserver(() => {
    resize();
    if (!running) draw(performance.now());
  }).observe(hero);
  new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(hero);

  /* ---------- Wordmark: weight follows the pointer ---------- */
  const letters = [...document.querySelectorAll<HTMLElement>('.mark-ch')];
  const weights = letters.map(() => 700);
  let mx = 0;
  let my = 0;

  const follow = (clientX: number, clientY: number) => {
    const rect = hero.getBoundingClientRect();
    pointer.active = true;
    pointer.tx = clientX - rect.left;
    pointer.ty = clientY - rect.top;
    mx = clientX;
    my = clientY;
  };
  const ripple = (clientX: number, clientY: number) => {
    if (reduce) return;
    const rect = hero.getBoundingClientRect();
    ripples.push({ x: clientX - rect.left, y: clientY - rect.top, t0: performance.now() });
    if (ripples.length > 5) ripples.shift();
  };

  // Mouse: follow on move, ripple on click.
  hero.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    pointer.touch = false;
    follow(e.clientX, e.clientY);
  });
  hero.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'mouse') pointer.active = false;
  });
  hero.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse') ripple(e.clientX, e.clientY);
  });

  // Touch: follow the finger (touch events keep firing while the page scrolls), ripple on tap,
  // then let the field drift again shortly after the finger lifts.
  let release = 0;
  hero.addEventListener(
    'touchstart',
    (e) => {
      const t = e.touches[0];
      clearTimeout(release);
      pointer.touch = true;
      follow(t.clientX, t.clientY);
      ripple(t.clientX, t.clientY);
    },
    { passive: true },
  );
  hero.addEventListener(
    'touchmove',
    (e) => {
      const t = e.touches[0];
      follow(t.clientX, t.clientY);
    },
    { passive: true },
  );
  const lift = () => {
    clearTimeout(release);
    release = window.setTimeout(() => (pointer.active = false), 700);
  };
  hero.addEventListener('touchend', lift, { passive: true });
  hero.addEventListener('touchcancel', lift, { passive: true });
  if (!reduce) {
    const tick = () => {
      if (running) {
        const reach = Math.min(170, W * 0.24);
        letters.forEach((el, i) => {
          let target = 700;
          if (pointer.active) {
            const b = el.getBoundingClientRect();
            const d = Math.hypot(mx - (b.left + b.width / 2), my - (b.top + b.height / 2));
            target = 220 + 680 * Math.exp(-(d * d) / (2 * reach * reach));
          }
          weights[i] += (target - weights[i]) * 0.12;
          el.style.fontVariationSettings = `'wght' ${weights[i].toFixed(0)}`;
        });
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  /* ---------- Intro ---------- */
  if (!reduce) {
    gsap.set('.mark-ch', { yPercent: 110 });
    gsap.set('[data-fade]', { opacity: 0 });
    gsap
      .timeline({ delay: 0.15 })
      .to(state, { intro: 1, duration: 2.2, ease: 'expo.inOut' }, 0)
      .to('.mark-ch', { yPercent: 0, duration: 1.3, ease: 'expo.out', stagger: 0.055 }, 0.55)
      .to('[data-fade]', { opacity: 1, duration: 1, stagger: 0.12 }, 1.5);
  }

  /* ---------- Manifesto: words light up as you read ---------- */
  if (!reduce) {
    gsap.fromTo(
      '[data-words] .w',
      { opacity: 0.12 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.12,
        scrollTrigger: { trigger: '[data-words]', start: 'top 78%', end: 'bottom 42%', scrub: 0.6 },
      },
    );
  }

  /* ---------- Journey: cognition (a network) becomes craft (arcs) becomes comfort (one arc) ---------- */
  const jStick = document.querySelector<HTMLElement>('.journey-stick')!;
  const jCanvas = document.querySelector<HTMLCanvasElement>('[data-journey-canvas]')!;
  const stagesBox = document.querySelector<HTMLElement>('.stages')!;
  const jx = jCanvas.getContext('2d')!;
  const stageEls = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const STOPS = [0.08, 0.5, 0.92];
  const LABELS = ['01 Cognition', '02 Craft', '03 Comfort'];

  type Particle = { ax: number; ay: number; bx: number; by: number; ca: number; cr: number; u: number; size: number; phase: number };
  let JW = 0;
  let JH = 0;
  let jdpr = 1;
  let geo = { cx: 0, cy: 0, R: 0 };
  let parts: Particle[] = [];
  let progress = reduce ? 1 : 0;
  const jp = { x: -9999, y: -9999, active: false };

  // Small seeded random so the network looks the same on every visit.
  let seed = 7;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  const gauss = () => Math.sqrt(-2 * Math.log(rnd() + 1e-9)) * Math.cos(2 * Math.PI * rnd());

  function layout() {
    jdpr = Math.min(window.devicePixelRatio || 1, 2);
    JW = jStick.clientWidth;
    JH = jStick.clientHeight;
    jCanvas.width = JW * jdpr;
    jCanvas.height = JH * jdpr;
    const phone = JW < 735;
    // The dial lives in the space under the stage text: measure where the text ends (the tallest
    // stage, since they share one cell) and fit the dial, its ticks and its top label below that.
    const stick = jStick.getBoundingClientRect();
    const textBottom = stagesBox.getBoundingClientRect().bottom - stick.top;
    const cy = phone ? JH * 0.92 : JH - 8;
    const room = (cy - textBottom - 72) / 1.02;
    const R = Math.max(110, Math.min(phone ? JW * 0.46 : JW * 0.42, room));
    geo = { cx: JW / 2, cy, R };
    seed = 7;
    const N = phone ? 230 : 420;
    const clusters = Array.from({ length: 7 }, () => {
      // Keep clusters off the dial's ends, where its labels sit.
      const a = Math.PI + 0.5 + rnd() * (Math.PI - 1);
      const r = R * (0.25 + rnd() * 0.55);
      return { x: geo.cx + Math.cos(a) * r, y: geo.cy + Math.sin(a) * r };
    });
    const RINGS = 6;
    // On phones the final arc stops short of the dial's ends, leaving room for its labels.
    const edge = phone ? 0.42 : 0.06;
    parts = Array.from({ length: N }, (_, i) => {
      const c = clusters[i % clusters.length];
      const ring = i % RINGS;
      const slot = Math.floor(i / RINGS);
      const perRing = Math.ceil(N / RINGS);
      const ba = Math.PI + 0.1 + ((Math.PI - 0.2) * (slot + 0.5)) / perRing;
      const br = R * (0.34 + (ring / (RINGS - 1)) * 0.56);
      const u = i / N;
      return {
        ax: c.x + gauss() * R * 0.11,
        ay: c.y + gauss() * R * 0.09,
        bx: geo.cx + Math.cos(ba) * br,
        by: geo.cy + Math.sin(ba) * br,
        ca: Math.PI + edge + (Math.PI - 2 * edge) * u,
        cr: R * 0.72 + gauss() * 3,
        u,
        size: 0.8 + rnd() * 1.1,
        phase: rnd() * Math.PI * 2,
      };
    });
  }

  const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
  const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - (-2 * v + 2) ** 3 / 2);
  /** How far a particle is through a morph that runs from `from` for `dur`, flowing along the arc. */
  const morph = (p: number, from: number, dur: number, u: number) => ease(clamp01((p - from - u * 0.1) / dur));

  function drawJourney(t: number) {
    const { cx, cy, R } = geo;
    const p = progress;
    jx.setTransform(jdpr, 0, 0, jdpr, 0, 0);
    jx.clearRect(0, 0, JW, JH);

    const network = 1 - clamp01((p - 0.18) / 0.2);
    const craft = Math.exp(-((p - 0.5) ** 2) / 0.012);
    const comfort = clamp01((p - 0.62) / 0.2);

    // Comfort: a warm light rises behind the final arc.
    if (comfort > 0) {
      const g = jx.createRadialGradient(cx, cy - R * 0.72, 0, cx, cy - R * 0.72, R * 1.1);
      g.addColorStop(0, `rgb(${EMBER} / ${0.22 * comfort})`);
      g.addColorStop(1, `rgb(${EMBER} / 0)`);
      jx.fillStyle = g;
      jx.fillRect(0, 0, JW, JH);
    }

    // Craft: faint guides for the arcs the particles settle on.
    if (craft > 0.02) {
      jx.lineWidth = 1;
      for (let k = 0; k < 6; k++) {
        jx.strokeStyle = `rgb(${BONE} / ${0.06 * craft})`;
        jx.beginPath();
        jx.arc(cx, cy, R * (0.34 + (k / 5) * 0.56), Math.PI, Math.PI * 2);
        jx.stroke();
      }
    }

    // Particle positions for this frame.
    const pts = parts.map((q) => {
      const ab = morph(p, 0.2, 0.22, q.u);
      const bc = morph(p, 0.6, 0.22, q.u);
      const drift = reduce ? 0 : 1;
      const ax = q.ax + Math.sin(t * 0.0006 + q.phase) * 6 * drift;
      const ay = q.ay + Math.cos(t * 0.0005 + q.phase) * 5 * drift;
      const breath = reduce ? 0 : Math.sin(t * 0.0012 + q.ca * 3) * 4;
      const cxp = cx + Math.cos(q.ca) * (q.cr + breath);
      const cyp = cy + Math.sin(q.ca) * (q.cr + breath);
      let x = ax + (q.bx - ax) * ab;
      let y = ay + (q.by - ay) * ab;
      x += (cxp - x) * bc;
      y += (cyp - y) * bc;
      if (jp.active) {
        const dx = x - jp.x;
        const dy = y - jp.y;
        const d = Math.hypot(dx, dy) || 1;
        const reach = Math.min(130, JW * 0.18);
        if (d < reach) {
          const push = (1 - d / reach) ** 2 * 34;
          x += (dx / d) * push;
          y += (dy / d) * push;
        }
      }
      return { x, y, q };
    });

    // Cognition: nearby nodes link up while the network lasts.
    if (network > 0.02) {
      const thr = R * 0.13;
      const thr2 = thr * thr;
      jx.lineWidth = 0.7;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const b = pts[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < thr2) {
            jx.strokeStyle = `rgb(${BONE} / ${(1 - d2 / thr2) * 0.28 * network})`;
            jx.beginPath();
            jx.moveTo(a.x, a.y);
            jx.lineTo(b.x, b.y);
            jx.stroke();
          }
        }
      }
    }

    // The particles themselves: bone, warming to ember as they reach comfort.
    for (const { x, y, q } of pts) {
      const warm = comfort * (0.4 + 0.6 * Math.sin(q.u * Math.PI));
      jx.fillStyle = warm > 0.05 ? `rgb(${EMBER} / ${0.45 + warm * 0.5})` : `rgb(${BONE} / 0.75)`;
      const s = q.size * (1 + comfort * 0.3);
      jx.fillRect(x - s / 2, y - s / 2, s, s);
    }

    // The dial: fine ticks along the outer arc, lit as you travel.
    const TICKS = 96;
    const outer = R * 1.02;
    for (let k = 0; k <= TICKS; k++) {
      const f = k / TICKS;
      const a = Math.PI + 0.05 + (Math.PI - 0.1) * f;
      const stop = STOPS.findIndex((s0) => Math.abs(s0 - f) < 0.5 / TICKS);
      const len = stop >= 0 ? 18 : k % 8 === 0 ? 10 : 5;
      const lit = f <= p;
      jx.strokeStyle = lit ? `rgb(${EMBER} / ${stop >= 0 ? 1 : 0.85})` : `rgb(${BONE} / ${stop >= 0 ? 0.35 : 0.14})`;
      jx.lineWidth = stop >= 0 ? 1.6 : 1;
      jx.beginPath();
      jx.moveTo(cx + Math.cos(a) * outer, cy + Math.sin(a) * outer);
      jx.lineTo(cx + Math.cos(a) * (outer + len), cy + Math.sin(a) * (outer + len));
      jx.stroke();
      if (stop >= 0) {
        // Phones have no room beside the dial, so the end labels sit just below its ends.
        const phone = JW < 735;
        const inside = phone && stop !== 1;
        const lr = inside ? outer : outer + 34;
        const lx = cx + Math.cos(a) * lr;
        const ly = cy + Math.sin(a) * lr + (inside ? 24 : 0);
        jx.font = `400 ${phone ? 10 : 12}px Lexend, system-ui, sans-serif`;
        jx.textAlign = inside ? (stop === 0 ? 'left' : 'right') : stop === 0 ? 'right' : stop === 2 ? 'left' : 'center';
        jx.textBaseline = 'middle';
        jx.fillStyle = lit ? `rgb(${EMBER} / 1)` : `rgb(${BONE} / 0.45)`;
        jx.fillText(LABELS[stop].toUpperCase(), lx, ly);
      }
    }
    // The head of the dial: where you are on the arc.
    const ha = Math.PI + 0.05 + (Math.PI - 0.1) * p;
    const hx = cx + Math.cos(ha) * (outer + 9);
    const hy = cy + Math.sin(ha) * (outer + 9);
    jx.fillStyle = `rgb(${BONE} / 1)`;
    jx.shadowColor = `rgb(${EMBER} / 0.9)`;
    jx.shadowBlur = 16;
    jx.beginPath();
    jx.arc(hx, hy, 4, 0, Math.PI * 2);
    jx.fill();
    jx.shadowBlur = 0;
  }

  // Stage words arrive letter by letter.
  const words = stageEls.map((el) => SplitText.create(el.querySelector('.stage-word')!, { type: 'chars' }));
  let current = -1;
  function showStage(idx: number) {
    if (idx === current) return;
    const prev = current;
    current = idx;
    stageEls.forEach((el, i) => el.classList.toggle('is-active', i === idx));
    if (reduce) return;
    if (prev >= 0) {
      gsap.to(words[prev].chars, { yPercent: -60, opacity: 0, filter: 'blur(6px)', duration: 0.45, stagger: 0.02, ease: 'power2.in', overwrite: true });
    }
    gsap.fromTo(
      words[idx].chars,
      { yPercent: 70, rotateX: -80, opacity: 0, filter: 'blur(8px)' },
      { yPercent: 0, rotateX: 0, opacity: 1, filter: 'blur(0px)', duration: 1, stagger: 0.04, ease: 'expo.out', delay: prev >= 0 ? 0.15 : 0, overwrite: true },
    );
  }

  let jRunning = false;
  let jRaf = 0;
  const jLoop = (t: number) => {
    drawJourney(t);
    jRaf = requestAnimationFrame(jLoop);
  };
  layout();
  document.fonts?.ready.then(() => {
    layout();
    drawJourney(performance.now());
  });
  new ResizeObserver(() => {
    layout();
    drawJourney(performance.now());
  }).observe(jStick);

  if (reduce) {
    drawJourney(0);
    stageEls.forEach((el) => el.classList.add('is-active'));
  } else {
    words.forEach((w) => gsap.set(w.chars, { opacity: 0 }));
    showStage(0);
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !jRunning) {
        jRunning = true;
        jRaf = requestAnimationFrame(jLoop);
      } else if (!e.isIntersecting) {
        jRunning = false;
        cancelAnimationFrame(jRaf);
      }
    }).observe(jStick);
    ScrollTrigger.create({
      trigger: '[data-journey]',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 0.9,
      onUpdate: (self) => {
        progress = self.progress;
        showStage(progress < 0.36 ? 0 : progress < 0.72 ? 1 : 2);
      },
    });

    // Particles part around the cursor or a finger.
    const at = (clientX: number, clientY: number) => {
      const r = jStick.getBoundingClientRect();
      jp.x = clientX - r.left;
      jp.y = clientY - r.top;
      jp.active = true;
    };
    jStick.addEventListener('pointermove', (e) => e.pointerType === 'mouse' && at(e.clientX, e.clientY));
    jStick.addEventListener('pointerleave', () => (jp.active = false));
    jStick.addEventListener('touchstart', (e) => at(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    jStick.addEventListener('touchmove', (e) => at(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    jStick.addEventListener('touchend', () => setTimeout(() => (jp.active = false), 400), { passive: true });
  }

  /* ---------- Contact: the email button leans toward the pointer ---------- */
  const magnet = document.querySelector<HTMLElement>('[data-magnet]');
  if (magnet && finePointer && !reduce) {
    magnet.addEventListener('pointermove', (e) => {
      const b = magnet.getBoundingClientRect();
      gsap.to(magnet, {
        x: (e.clientX - (b.left + b.width / 2)) * 0.25,
        y: (e.clientY - (b.top + b.height / 2)) * 0.35,
        duration: 0.6,
        ease: 'power3.out',
      });
    });
    magnet.addEventListener('pointerleave', () => gsap.to(magnet, { x: 0, y: 0, duration: 0.9, ease: 'elastic.out(1, 0.4)' }));
  }

  /* ---------- Index in the bar ---------- */
  const index = document.querySelector<HTMLElement>('[data-index]')!;
  ScrollTrigger.create({
    trigger: '[data-hero]',
    start: 'top top',
    end: 'bottom 50%',
    onToggle: (s) => s.isActive && (index.textContent = '01'),
  });
  document.querySelectorAll<HTMLElement>('[data-section]').forEach((el) =>
    ScrollTrigger.create({
      trigger: el,
      start: 'top 50%',
      end: 'bottom 50%',
      onToggle: (s) => s.isActive && (index.textContent = el.dataset.section!),
    }),
  );
</script>


