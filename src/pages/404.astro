---
import QigLayout from '../layouts/QigLayout.astro';
import QigArt from '../components/QigArt.astro';
---

<QigLayout title="Page Not Found | Qwantarc" description="The page you’re looking for can’t be found." bare crumbs={[{ label: 'Not found' }]}>
  <header class="page-hero is-tall is-wide">
    <QigArt seed="not-found" ratio={2.2} bend />
    <div class="page-hero-copy">
      <p class="eyebrow"><span class="num">404</span> Off the arc</p>
      <h1 class="page-title">Page not found</h1>
    </div>
  </header>
  <div class="overview-body">
    <p class="lede">This page can’t be found. It may have moved, or the address may be mistyped.</p>
    <div class="actions">
      <a class="button" href="/design/qig">Go to the Guidelines</a>
      <a class="button is-secondary" href="https://qwantarc.com">Qwantarc.com</a>
    </div>
  </div>
</QigLayout>
