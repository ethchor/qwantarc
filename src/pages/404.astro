---
import QigLayout from '../layouts/QigLayout.astro';
---

<QigLayout title="Page Not Found | Qwantarc" description="The page you’re looking for can’t be found." bare crumbs={[{ label: 'Not found' }]}>
  <div class="overview">
    <header class="overview-head" style="padding-block: 96px 40px">
      <h1 style="margin:0;font-size:48px;letter-spacing:-0.03em">Page not found</h1>
      <p class="lede">The page you’re looking for can’t be found. It may have moved, or the address may be mistyped.</p>
      <div class="actions">
        <a class="button" href="/design/qig">Go to the Guidelines</a>
        <a class="button is-secondary" href="https://qwantarc.com">Qwantarc.com</a>
      </div>
    </header>
  </div>
</QigLayout>
