---
import Base from './Base.astro';
import { BRAND_URL, QIG_BASE, QIG_NAME, getNav, pageUrl } from '../lib/qig';
import '../styles/qig.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  /** Page id or section id that is selected in the sidebar. */
  current?: string;
  crumbs?: Crumb[];
  /** Hide the sidebar (the design hub). */
  bare?: boolean;
}

const { title, description, current, crumbs = [], bare = false } = Astro.props;
const nav = bare ? [] : await getNav();
const openSection = nav.find((s) => s.id === current || s.pages.some((p) => p.id === current))?.id;
const allCrumbs: Crumb[] = [{ label: 'Developer', href: '/design' }, ...crumbs];
---

<Base title={title} description={description}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="globalnav">
    <div class="globalnav-inner">
      <a class="globalnav-brand" href="/design" aria-label="Qwantarc Developer">
        <svg viewBox="0 0 32 32" aria-hidden="true"><use href="#qw-mark"></use></svg>
        <span>Developer</span>
      </a>
      <nav aria-label="Developer">
        <ul>
          <li><a href="/design" aria-current={bare ? 'page' : undefined}>Design</a></li>
          <li><a href={QIG_BASE} aria-current={!bare ? 'true' : undefined}>QIG</a></li>
          <li><a href={pageUrl('design-values')}>Design Values</a></li>
          <li><a href={BRAND_URL}>Qwantarc.com</a></li>
        </ul>
      </nav>
    </div>
  </header>

  {
    !bare && (
      <div class="localnav">
        <div class="localnav-inner">
          <button class="localnav-menu" type="button" aria-controls="qig-sidebar" aria-expanded="false" data-sidebar-toggle>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span class="sr-only">Show the contents</span>
          </button>
          <a class="localnav-title" href={QIG_BASE}>
            {QIG_NAME}
          </a>
        </div>
      </div>
    )
  }

  <div class:list={['qig-shell', { 'is-bare': bare }]}>
    {
      !bare && (
        <aside class="sidebar" id="qig-sidebar" aria-label="Guidelines">
          <div class="sidebar-scroll">
            <a class="sidebar-home" href={QIG_BASE} aria-current={current === 'home' ? 'page' : undefined}>
              {QIG_NAME}
            </a>
            <ul class="sidebar-tree">
              {nav.map((section) => (
                <li data-section>
                  <details open={openSection === section.id}>
                    <summary>
                      <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                        <path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <a href={pageUrl(section.id)} aria-current={current === section.id ? 'page' : undefined}>
                        {section.title}
                      </a>
                    </summary>
                    {section.groups.map((group) =>
                      group.title ? (
                        <details class="sidebar-group" open={group.pages.some((p) => p.id === current)} data-group>
                          <summary>
                            <svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
                              <path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>{group.title}</span>
                          </summary>
                          <ul>
                            {group.pages.map((page) => (
                              <li data-item={page.data.title.toLowerCase()}>
                                <a href={pageUrl(page.id)} aria-current={page.id === current ? 'page' : undefined}>
                                  {page.data.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ) : (
                        <ul>
                          {group.pages.map((page) => (
                            <li data-item={page.data.title.toLowerCase()}>
                              <a href={pageUrl(page.id)} aria-current={page.id === current ? 'page' : undefined}>
                                {page.data.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      ),
                    )}
                  </details>
                </li>
              ))}
            </ul>
            <p class="sidebar-empty" hidden data-filter-empty>
              No matches
            </p>
          </div>
          <div class="sidebar-filter">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M12.5 12.5 17 17M14 8.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <input type="search" placeholder="Filter" aria-label="Filter the guidelines" data-filter autocomplete="off" />
          </div>
        </aside>
      )
    }
    <div class="sidebar-scrim" data-sidebar-scrim hidden></div>

    <main id="main" class="main">
      <slot />
      <footer class="footer">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {
              allCrumbs.map((c, i) => (
                <li>{c.href && i < allCrumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))
            }
          </ol>
        </nav>
        <p class="legal">
          Copyright © {new Date().getFullYear()} <a href={BRAND_URL}>Qwantarc</a>. All rights reserved.
        </p>
      </footer>
    </main>
  </div>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="qw-mark" viewBox="0 0 32 32">
      <circle cx="16" cy="16" r="10.5" fill="none" stroke="currentColor" stroke-width="3.2"></circle>
      <path d="M19.5 19.5 26 26" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"></path>
    </symbol>
  </svg>

  <script>
    const sidebar = document.getElementById('qig-sidebar');
    const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
    const scrim = document.querySelector<HTMLElement>('[data-sidebar-scrim]');
    const setOpen = (open: boolean) => {
      sidebar?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (scrim) scrim.hidden = !open;
      document.documentElement.classList.toggle('sidebar-open', open);
    };
    toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('is-open')));
    scrim?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar?.classList.contains('is-open')) setOpen(false);
    });

    // Keep the selected page in view inside the sidebar.
    // (Scroll only the sidebar's own scroller; scrollIntoView would move the page too.)
    const scroller = sidebar?.querySelector<HTMLElement>('.sidebar-scroll');
    const selected = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (scroller && selected) {
      const offset = selected.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
      if (offset > scroller.clientHeight - 40) scroller.scrollTop = offset - scroller.clientHeight / 2;
    }

    // Filter: show matching pages and open their sections.
    const filter = document.querySelector<HTMLInputElement>('[data-filter]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
    const initialOpen = new Map([...document.querySelectorAll('details')].map((d) => [d, d.open]));
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let any = false;
      for (const section of sections) {
        let hits = 0;
        for (const item of section.querySelectorAll<HTMLElement>('[data-item]')) {
          const match = !q || item.dataset.item!.includes(q);
          item.hidden = !match;
          if (match) hits++;
        }
        for (const group of section.querySelectorAll<HTMLDetailsElement>('[data-group]')) {
          const visible = [...group.querySelectorAll<HTMLElement>('[data-item]')].some((i) => !i.hidden);
          group.hidden = !visible;
          group.open = q ? visible : initialOpen.get(group)!;
        }
        section.hidden = !!q && !hits;
        const details = section.querySelector('details')!;
        details.open = q ? hits > 0 : initialOpen.get(details)!;
        any ||= hits > 0;
      }
      if (empty) empty.hidden = any || !q;
    });
  </script>
</Base>
