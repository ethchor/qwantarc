---
/**
 * Generated artwork for a QIG page: concentric arcs over the section's gradient, laid out from a
 * hash of the page id so every page gets its own, stable image.
 */
import { hash } from '../lib/qig';

interface Props {
  seed: string;
  colors: [string, string];
  /** Width ÷ height. */
  ratio?: number;
  class?: string;
}

const { seed, colors, ratio = 2.6, class: className } = Astro.props;
const W = 1200;
const H = Math.round(W / ratio);
let state = hash(seed) || 1;
const rand = () => {
  state = Math.imul(state ^ (state >>> 15), 2246822507) ^ Math.imul(state ^ (state >>> 13), 3266489909);
  return ((state ^= state >>> 16) >>> 0) / 4294967296;
};

const id = `qa-${hash(seed).toString(36)}`;
const cx = W * (0.25 + rand() * 0.5);
const cy = H * (0.95 + rand() * 0.45);
const angle = Math.round(rand() * 360);
const count = 6 + Math.floor(rand() * 4);
const gap = 34 + rand() * 30;
const base = 90 + rand() * 80;
const accentIndex = 2 + Math.floor(rand() * (count - 3));

const point = (r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy - r * Math.sin(a)] as const;
};
const arcs = Array.from({ length: count }, (_, i) => {
  const r = base + i * gap;
  const from = 180 - (8 + rand() * 40);
  const sweep = 40 + rand() * 110;
  const to = from - sweep;
  const [x1, y1] = point(r, from);
  const [x2, y2] = point(r, to);
  return {
    d: `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${r} ${r} 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    end: [x2, y2] as const,
    accent: i === accentIndex,
    opacity: 0.16 + (i / count) * 0.3,
  };
});
const guide = Array.from({ length: count + 4 }, (_, i) => base + (i - 2) * gap).filter((r) => r > 20);
---

<svg
  class:list={['qig-art', className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${id}-bg`} gradientTransform={`rotate(${angle} .5 .5)`}>
      <stop offset="0" stop-color={colors[0]} />
      <stop offset="1" stop-color={colors[1]} />
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx={cx / W} cy={Math.min(cy / H, 1)} r="0.75">
      <stop offset="0" stop-color="#fff" stop-opacity="0.35" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#${id}-bg)`} />
  <rect width={W} height={H} fill={`url(#${id}-glow)`} />
  {guide.map((r) => <circle cx={cx} cy={cy} r={r} fill="none" stroke="#fff" stroke-opacity="0.07" stroke-width="1.5" />)}
  {
    arcs.map((arc) =>
      arc.accent ? (
        <g>
          <path d={arc.d} fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" />
          <circle cx={arc.end[0]} cy={arc.end[1]} r="15" fill="#fff" />
          <circle cx={arc.end[0]} cy={arc.end[1]} r="30" fill="none" stroke="#fff" stroke-opacity="0.45" stroke-width="2" />
        </g>
      ) : (
        <g>
          <path d={arc.d} fill="none" stroke="#fff" stroke-opacity={arc.opacity} stroke-width="5" stroke-linecap="round" />
          <circle cx={arc.end[0]} cy={arc.end[1]} r="5" fill="#fff" fill-opacity={arc.opacity + 0.2} />
        </g>
      ),
    )
  }
</svg>

<style>
  .qig-art {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
