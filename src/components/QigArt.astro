---
/**
 * The arc field from qwantarc.com as a still image: fine concentric arcs, bent around one point,
 * with a single ember arc. Laid out from a hash of `seed`, so every page gets its own, stable image.
 * `bend` draws the bent field (page headers); without it the arcs are plain and the SVG stays tiny (cards).
 */
import { hash } from '../lib/qig';

interface Props {
  seed: string;
  /** Width ÷ height. */
  ratio?: number;
  bend?: boolean;
  class?: string;
}

const { seed, ratio = 2.6, bend = false, class: className } = Astro.props;
const W = 1200;
const H = Math.round(W / ratio);
let state = hash(seed) || 1;
const rand = () => {
  state = Math.imul(state ^ (state >>> 15), 2246822507) ^ Math.imul(state ^ (state >>> 13), 3266489909);
  return ((state ^= state >>> 16) >>> 0) / 4294967296;
};

const id = `qa-${hash(seed).toString(36)}`;
const cx = W * (0.3 + rand() * 0.4);
const cy = H * (1.05 + rand() * 0.35);
const px = W * (0.2 + rand() * 0.6);
const py = H * (0.3 + rand() * 0.35);
const sigma = Math.min(W, H) * 0.32;
const pull = 0.4;

const maxR = Math.hypot(Math.max(cx, W - cx), cy) * 1.02;
const radii: number[] = [];
let r = H * (0.25 + rand() * 0.2);
let gap = bend ? 10 : 18;
while (r < maxR) {
  radii.push(r);
  r += gap;
  gap *= bend ? 1.05 : 1.08;
}
const pr = Math.hypot(px - cx, py - cy);
let ember = radii.findIndex((rr, i) => pr >= rr && pr < (radii[i + 1] ?? rr + gap));
if (ember < 0) ember = Math.floor(radii.length / 3);

const f1 = (n: number) => n.toFixed(1);
const paths = radii.map((rad, i) => {
  if (!bend) {
    // Plain arc across the visible top half.
    return `M ${f1(cx - rad)} ${f1(cy)} A ${f1(rad)} ${f1(rad)} 0 0 1 ${f1(cx + rad)} ${f1(cy)}`;
  }
  const n = Math.max(40, Math.round((Math.PI * rad) / 22));
  let d = '';
  for (let k = 0; k <= n; k++) {
    const a = Math.PI + (Math.PI * k) / n;
    let x = cx + Math.cos(a) * rad;
    let y = cy + Math.sin(a) * rad;
    const dx = px - x;
    const dy = py - y;
    const f = pull * Math.exp(-(dx * dx + dy * dy) / (2 * sigma * sigma));
    x += dx * f;
    y += dy * f;
    d += `${k ? 'L' : 'M'}${f1(x)} ${f1(y)}`;
  }
  return d;
});
const opacity = (i: number) => (0.06 + (1 - i / radii.length) * 0.1).toFixed(3);
---

<svg class:list={['qig-art', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={`${id}-glow`} cx={px / W} cy={py / H} r="0.6">
      <stop offset="0" stop-color="#ff7043" stop-opacity="0.16"></stop>
      <stop offset="1" stop-color="#ff7043" stop-opacity="0"></stop>
    </radialGradient>
    <filter id={`${id}-blur`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6"></feGaussianBlur>
    </filter>
  </defs>
  <rect width={W} height={H} fill="#0d0d0c"></rect>
  <rect width={W} height={H} fill={`url(#${id}-glow)`}></rect>
  <g fill="none" stroke="#ece9e3" stroke-width={bend ? 1 : 1.4}>
    {paths.map((d, i) => i !== ember && <path d={d} stroke-opacity={opacity(i)} />)}
  </g>
  <path class="ember" d={paths[ember]} fill="none" stroke="#ff7043" stroke-width="7" stroke-opacity="0.35" filter={`url(#${id}-blur)`}></path>
  <path class="ember" d={paths[ember]} fill="none" stroke="#ff7043" stroke-width={bend ? 1.8 : 2.4}></path>
</svg>

<style>
  .qig-art {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
