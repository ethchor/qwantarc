---
/**
 * A case's system diagram: nodes on a 420 by 230 grid, links between them and packets of data
 * travelling along the links, in the case's colour. When it scrolls into view the page adds
 * .is-drawn: the links draw themselves and the nodes pop in (styles in ethchor.css). Hovering or
 * focusing an architecture decision lights the nodes it is about; the packets stop for reduced motion.
 */
import type { Diagram } from '../../lib/ethchor/profile';

interface Props {
  id: string;
  diagram: Diagram;
  label: string;
}

const { id, diagram, label } = Astro.props;
const W = 420;
const H = 230;
/** Advance of the mono labels at 12 units. */
const CHAR = 7.25;
const nodes = diagram.nodes.map((n) => ({ ...n, w: Math.round(n.label.length * CHAR + 24), h: 30 }));
const at = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = diagram.edges.map(([a, b, both], i) => {
  const A = at[a];
  const B = at[b];
  const len = Math.hypot(B.x - A.x, B.y - A.y);
  return {
    id: `${id}-link-${i}`,
    a,
    b,
    both: !!both,
    d: `M${A.x} ${A.y} L${B.x} ${B.y}`,
    // Packets take about the same time per unit of length, with a little variety.
    dur: (len / 62 + 1.1 + (i % 3) * 0.25).toFixed(2),
    begin: ((i * 0.53) % 1.7).toFixed(2),
  };
});
---

<svg class="diagram" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} data-diagram>
  <g class="links">
    {edges.map((e, i) => <path id={e.id} class="link" d={e.d} data-a={e.a} data-b={e.b} pathLength="1" style={`--i: ${i}`} />)}
  </g>
  <g class="packets" aria-hidden="true">
    {
      edges.map((e) => (
        <>
          <circle class="packet" r="3.2">
            <animateMotion dur={`${e.dur}s`} begin={`${e.begin}s`} repeatCount="indefinite" calcMode="linear">
              <mpath href={`#${e.id}`} />
            </animateMotion>
          </circle>
          {e.both && (
            <circle class="packet is-back" r="2.6">
              <animateMotion
                dur={`${e.dur}s`}
                begin={`${(Number(e.begin) + Number(e.dur) / 2).toFixed(2)}s`}
                repeatCount="indefinite"
                keyPoints="1;0"
                keyTimes="0;1"
                calcMode="linear"
              >
                <mpath href={`#${e.id}`} />
              </animateMotion>
            </circle>
          )}
        </>
      ))
    }
  </g>
  <g class="nodes">
    {
      nodes.map((n, i) => (
        <g class="node" data-node={n.id} transform={`translate(${n.x - n.w / 2} ${n.y - n.h / 2})`}>
          <g class="node-in" style={`--i: ${i}`}>
            <rect width={n.w} height={n.h} rx="9" />
            <text x={n.w / 2} y={n.h / 2 + 4.2} text-anchor="middle">
              {n.label}
            </text>
          </g>
        </g>
      ))
    }
  </g>
</svg>
