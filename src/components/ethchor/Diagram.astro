---
/**
 * A case's system diagram, printed Bauhaus-style: each node is a chip carrying the shape of what it
 * is (a yellow triangle for an app, a blue circle for a service, a red square for data, a black
 * half-disc for a system outside the build), links are ink lines, and data moves along them as
 * pixel squares. Nodes sit on a 420 by 230 grid.
 *
 * When its project arrives the page adds .is-in: the links draw themselves and the chips pop in
 * (styles in ethchor.css). Chip widths are estimated here and measured again in the browser once the
 * font has loaded (fitDiagrams in the page script). Hovering a decision lights the nodes it is about.
 */
import { GLYPHS } from '../../lib/ethchor/glyphs';
import type { Diagram } from '../../lib/ethchor/profile';

interface Props {
  id: string;
  diagram: Diagram;
  label: string;
}

const { id, diagram, label } = Astro.props;
const W = 420;
const H = 230;
/** Average advance of the labels at 12.5px, the glyph, and the padding around them. */
const CHAR = 6.6;
const GLYPH = 30;
const nodes = diagram.nodes.map((n) => ({ ...n, w: Math.round(GLYPH + n.label.length * CHAR + 12), h: 30 }));
const at = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = diagram.edges.map(([a, b, both], i) => {
  const A = at[a];
  const B = at[b];
  const len = Math.hypot(B.x - A.x, B.y - A.y);
  return {
    id: `${id}-link-${i}`,
    a,
    b,
    both: !!both,
    d: `M${A.x} ${A.y} L${B.x} ${B.y}`,
    // Packets take about the same time per unit of length, with a little variety.
    dur: (len / 62 + 1.1 + (i % 3) * 0.25).toFixed(2),
    begin: ((i * 0.53) % 1.7).toFixed(2),
  };
});
---

<svg class="diagram" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} data-diagram>
  <g class="links">
    {edges.map((e, i) => <path id={e.id} class="link" d={e.d} data-a={e.a} data-b={e.b} pathLength="1" style={`--i: ${i}`} />)}
  </g>
  <g class="packets" aria-hidden="true">
    {
      edges.map((e) => (
        <>
          <rect class="packet" x="-2.5" y="-2.5" width="5" height="5">
            <animateMotion dur={`${e.dur}s`} begin={`${e.begin}s`} repeatCount="indefinite" calcMode="linear">
              <mpath href={`#${e.id}`} />
            </animateMotion>
          </rect>
          {e.both && (
            <rect class="packet is-back" x="-2" y="-2" width="4" height="4">
              <animateMotion
                dur={`${e.dur}s`}
                begin={`${(Number(e.begin) + Number(e.dur) / 2).toFixed(2)}s`}
                repeatCount="indefinite"
                keyPoints="1;0"
                keyTimes="0;1"
                calcMode="linear"
              >
                <mpath href={`#${e.id}`} />
              </animateMotion>
            </rect>
          )}
        </>
      ))
    }
  </g>
  <g class="nodes">
    {
      nodes.map((n, i) => (
        <g class="node" data-node={n.id} data-kind={n.kind} data-cx={n.x} data-cy={n.y} transform={`translate(${n.x - n.w / 2} ${n.y - n.h / 2})`}>
          <g class="node-in" style={`--i: ${i}`}>
            <rect class="chip" width={n.w} height={n.h} />
            <Fragment set:html={GLYPHS[n.kind]} />
            <text x={GLYPH} y={n.h / 2 + 4.3}>
              {n.label}
            </text>
          </g>
        </g>
      ))
    }
  </g>
</svg>
